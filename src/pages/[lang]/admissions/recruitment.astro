---
import ListContainer from "@/components/widgets/list/ListContainer.astro";
import ListProcess from "@/components/widgets/list/ListProcess.astro";
import { getLocale, useI18n } from "@/i18n/i18n";
import PageTitleTypography from "@components/widgets/heading/typographyHeading.astro";
import Layout from "@layouts/main.astro";

const messages = {
  en: {
    pageTitle: "Recruitment",
    title: "FEB Bilingual Class Program",
    description:
      "FEB Bilingual Class Program is an academic program that requires students to be active in various global academic activities. Students taking part in this program will experience the atmosphere of international education. The Bilingual Class is a bi-language class in which 70% English and 30% Indonesian are taught daily. In the Bilingual Class, students get used to communicating in English, have more opportunities for international exposure, and have the chance to participate in an international exchange program with partner universities.",
    certificate_info:
      "Graduating students who take this bilingual class program will receive a certificate indicating that they have completed the program. The issuance of the certificate can be completed here. The certificate will increase a student's credibility when they graduate and apply for jobs.",
    admission_title: "Admission and Requirements",
    requirements: [
      {
        text: `
        Applicants must be FEB UNEJ <span class="fw-700 text-dark-gray fs-18">2nd semester undergraduate students.</span>
        `,
      },
      {
        text: "Applicants must have a  <span class='fw-700 text-dark-gray fs-18'>minimum GPA of 3.00</span>, evidenced by the 2nd semester study result sheet.",
      },
      {
        text: "Applicants should demonstrate a good command of English, as evidenced by one of these following <span class='fw-700 text-dark-gray fs-18'>English proficiency test results:</span>",
        english_tests: [
          "IELTS ≥ 4.5",
          "iBT TOEFL ≥ 33",
          "ITP TOEFL ≥ 450",
          "TOEIC ≥ 350",
          "Duolingo ≥ 70",
          "EPT LC UNEJ ≥ 450",
        ],
      },
      {
        text: "Applicants must upload a <span class='fw-700 text-dark-gray fs-18'>Motivation Letter</span> (free format, handwritten or typed).",
      },
      {
        text: "Applicants must <span class='fw-700 text-dark-gray fs-18'>attend the interview</span> on the announced schedule.",
      },
    ],
    more_info:
      "More information can be found in the Bilingual Class Admission Handbook ",
  },

  id: {
    pageTitle: "Pendaftaran",
    title: "Program Kelas Bilingual FEB",
    description:
      "Program Kelas Bilingual FEB adalah program akademik yang mengharuskan mahasiswa aktif dalam berbagai kegiatan akademik global. Mahasiswa yang mengikuti program ini akan merasakan atmosfer pendidikan internasional. Kelas Bilingual adalah kelas dwibahasa dengan proporsi penggunaan bahasa 70% Inggris dan 30% Indonesia setiap hari. Dalam Kelas Bilingual, mahasiswa terbiasa berkomunikasi dalam bahasa Inggris, memiliki lebih banyak kesempatan untuk mendapatkan paparan internasional, serta berpeluang mengikuti program pertukaran pelajar dengan universitas mitra.",
    certificate_info:
      "Mahasiswa yang lulus dan mengikuti program kelas bilingual ini akan menerima sertifikat yang menyatakan bahwa mereka telah menyelesaikan program. Penerbitan sertifikat dapat dilakukan di sini. Sertifikat tersebut akan meningkatkan kredibilitas mahasiswa ketika lulus dan melamar pekerjaan.",
    admission_title: "Pendaftaran dan Persyaratan",
    requirements: [
      {
        text: "Pendaftar harus merupakan <span class='fw-700 text-dark-gray fs-18'>mahasiswa S1 FEB UNEJ semester 2.</span>",
      },
      {
        text: "Pendaftar harus memiliki <span class='fw-700 text-dark-gray fs-18'>IPK minimal 3.00</span>, dibuktikan dengan lembar hasil studi semester 2.",
      },
      {
        text: "Pendaftar harus menunjukkan <span class='fw-700 text-dark-gray fs-18'>kemampuan bahasa Inggris yang baik</span>, dibuktikan dengan salah satu hasil tes berikut:",
        english_tests: [
          "IELTS ≥ 4.5",
          "iBT TOEFL ≥ 33",
          "ITP TOEFL ≥ 450",
          "TOEIC ≥ 350",
          "Duolingo ≥ 70",
          "EPT LC UNEJ ≥ 450",
        ],
      },
      {
        text: "Pendaftar harus mengunggah <span class='fw-700 text-dark-gray fs-18'>Motivation Letter</span> (format bebas, ditulis tangan atau diketik).",
      },
      {
        text: "Pendaftar harus <span class='fw-700 text-dark-gray fs-18'>mengikuti wawancara</span> sesuai jadwal yang diumumkan.",
      },
    ],
    more_info:
      "Informasi lebih lanjut dapat ditemukan pada Buku Panduan Pendaftaran Kelas Bilingual ",
  },
};
const t = useI18n(messages, getLocale(Astro));
---

<Layout title={t.pageTitle}>
  <PageTitleTypography title={t.pageTitle} image="/_astro/images/bg-feb.webp" />

  <section>
    <div class="container position-relative">
      <div class="row align-items-center">
        <div class="md-mb-15 sm-mb-20 text-center text-lg-start">
          <!-- TITLE -->
          <span
            class="ps-25px pe-25px mb-20px text-uppercase text-base-color fs-14 lh-42px fw-700 border-radius-100px bg-gradient-very-light-gray-transparent d-inline-block"
          >
            {t.title}
          </span>

          <!-- DESCRIPTION -->
          <p class="text-dark-gray fw-500 mb-30px">
            {t.description}
          </p>

          <!-- CERTIFICATE INFO -->
          <p class="text-dark-gray fw-500 mb-30px">
            {t.certificate_info}
          </p>

          <!-- ADMISSION TITLE -->
          <p class="fw-700 text-dark-gray mb-20px">
            {t.admission_title}
          </p>

          <!-- REQUIREMENTS -->
          <ListContainer class="row-cols-1">
            <ListProcess number={1}>
              <div
                slot="title"
                set:html={t.requirements[0].text}
                class="fw-500 text-secondary fs-18"
              />
            </ListProcess>
            <ListProcess number={2}>
              <div
                slot="title"
                set:html={t.requirements[1].text}
                class="fw-500 text-secondary fs-18"
              />
            </ListProcess>
            <ListProcess number={3}>
              <div
                slot="title"
                set:html={t.requirements[2].text}
                class="fw-500 text-secondary fs-18"
              />
              <ul
                class="mt-10px"
                slot="content"
                style="list-style-type: circle !important;"
              >
                {
                  t.requirements[2].english_tests?.map((test) => (
                    <li class="mb-5px  text-dark-gray">
                      <span class=" text-secondary">{test}</span>
                    </li>
                  ))
                }
              </ul>
            </ListProcess>
            <ListProcess number={4}>
              <div
                slot="title"
                set:html={t.requirements[3].text}
                class="fw-500 text-secondary fs-18"
              />
            </ListProcess>
            <ListProcess number={5} isLast>
              <div
                slot="title"
                set:html={t.requirements[4].text}
                class="fw-500 text-secondary fs-18"
              />
            </ListProcess>
          </ListContainer>

          <!-- MORE INFO -->
          <p class="text-dark-gray fw-700 mt-40px ms-5">
            {t.more_info}
            <a href="#" class="text-primary">here</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
