---
import { getLocale, useI18n } from "@/i18n/i18n";
import { wordsJson } from "@/i18n/words";
import PageTitleTypography from "@components/widgets/pageTitleTypography.astro";
import Layout from "@layouts/main.astro";
import axios from "axios";

const messages = {
  en: {
    pageTitle: "Administrative Staff",

    personal_identity: "Personal Identity",
    academic_information: "Academic Information",
    employment_information: "Employment Information",
    assignment: "Assignment",

    name: "Name",
    employee_number: "Employee Number",
    nidn: "NIDN",
    nuptk: "NUPTK",
    gender: "Gender",
    email: "Email",

    field_of_study: "Field of Study",
    education: "Education",
    homebase_faculty: "Homebase Faculty",
    homebase_study_program: "Homebase Study Program",

    employment_status: "Employment Status",
    functional_position: "Functional Position",
    work_status: "Work Status",
    rank_grade: "Rank/Grade",

    assignment_faculty: "Assignment Faculty",
    assignment_study_program: "Assignment Study Program",
  },
  id: {
    pageTitle: "Staf Administrasi",

    personal_identity: "Identitas Diri",
    academic_information: "Informasi Akademik",
    employment_information: "Informasi Kepegawaian",
    assignment: "Penugasan",

    name: "Nama",
    employee_number: "Nomor Pegawai",
    nidn: "NIDN",
    nuptk: "NUPTK",
    gender: "Jenis Kelamin",
    email: "Email",

    field_of_study: "Bidang Ilmu",
    education: "Pendidikan",
    homebase_faculty: "Homebase Fakultas",
    homebase_study_program: "Homebase Prodi",

    employment_status: "Status Pegawai",
    functional_position: "Jabatan Fungsional",
    work_status: "Status Kerja",
    rank_grade: "Pangkat Golongan",

    assignment_faculty: "Penugasan Fakultas",
    assignment_study_program: "Penugasan Prodi",
  },
};
const t = useI18n(messages, getLocale(Astro));
const tWords = useI18n(wordsJson, getLocale(Astro));

export type StaffData = {
  id: string;
  nama: string;
  nama_gelar: string;
  nomor_pegawai: string;
  nidn: string;
  nuptk: string;
  email: string;
  bidang_ilmu: string;
  jenis_kelamin: string;
  homebase_fakultas: string;
  homebase_prodi: string;
  status_pegawai: string;
  jabatan_fungsional: string;
  status_kerja: string;
  penugasan_fakultas: string;
  penugasan_prodi: string;
  pangkat_golongan: string;
  pendidikan: string;
};

const api = axios.create({
  baseURL: "https://simfeb.feb.unej.ac.id/api/public",
  headers: {
    "x-api-key": "!!b@pH0m3t*00",
  },
  timeout: 15000,
});

const getDosen = () => api.get<StaffData[]>("/dosen");

const dosenRes = await getDosen();
const dosen = dosenRes.data;
console.log(dosen);
---

<Layout title={t.pageTitle}>
  <PageTitleTypography title={t.pageTitle} image="/_astro/images/bg-feb.webp" />
  <section class="bg-very-light-gray" id="agents">
    <div class="container">
      <div class="row mb-4">
        <div
          class="col-12 text-center"
          data-anime='{ "el": "childs", "translateY": [30, 0], "opacity": [0,1], "duration": 600, "delay": 0, "staggervalue": 300, "easing": "easeOutQuad" }'
        >
          <h3
            class="alt-font fw-500 text-dark-gray ls-minus-1px shadow-none"
            data-shadow-animation="true"
            data-animation-delay="700"
          >
            <span class="fw-700 text-highlight d-inline-block">
              {t.pageTitle}
              <span
                class="bg-base-color h-10px bottom-5px opacity-3 separator-animation"
              ></span></span
            >
          </h3>
        </div>
      </div>
      <div
        class="row row-cols-1 row-cols-xl-3 row-cols-lg-3 row-cols-sm-2 justify-content-center mb-6 xs-mb-10"
        data-anime='{ "el": "childs", "perspective": [900, 1200], "scaleY": [1.1, 1], "rotateY": [-30, 0], "opacity": [0,1], "duration": 600, "delay": 0, "staggervalue": 300, "easing": "easeOutQuad" }'
      >
        <!-- start team member item -->
        {
          dosen.map((data) => (
            <div class="col team-style-06 mb-30px">
              <div class="d-flex flex-column p-40px pb-20px lg-p-30px text-center border-radius-6px bg-white box-shadow-quadruple-large position-relative">
                <div class="position-relative">
                  <a
                    href="demo-real-estate-agent-details.html"
                    class="d-inline-block position-relative"
                  >
                    <img
                      class="rounded-circle w-150px h-150px mb-20px"
                      src="https://thumb.viva.id/intipseleb/663x372/2024/05/21/664c0ff81833a-btr-nadine.jpg"
                      alt=""
                      is="auto-bg-color"
                      width="150"
                      height="150"
                      loading="lazy"
                      style=" object-fit: cover;"
                    />
                  </a>
                </div>
                <a
                  href="demo-real-estate-agent-details.html"
                  class="text-dark-gray alt-font fs-19 fw-600 mb-5px"
                >
                  {data.nama}
                </a>
                <p class="w-90 mx-auto lh-28">{data.nomor_pegawai}</p>
                <div class="text-center elements-social social-icon-style-02 border-top border-color-light-medium-gray w-100 pt-15px">
                  <ul class="small-icon dark">
                    <li>
                      <detail-button
                        data-detail={JSON.stringify(data)}
                        data-template="#detail-template"
                      >
                        <div class="d-flex gap-1 justify-content-center align-items-center">
                          <i class="fa-solid fa-magnifying-glass" />
                          <span>{tWords.read_more}</span>
                        </div>
                      </detail-button>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          ))
        }
        <!-- end team member item -->
      </div>
    </div>
  </section>
  <template id="detail-template">
    <div class="container staff-detail">
      <div class="row">
        <div class="col-12">
          <!-- Card Header -->
          <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
              <h4 class="mb-0">
                <i class="bi bi-person-circle me-2"></i>[nama_gelar]
              </h4>
            </div>
            <div class="card-body">
              <p class="mb-0">
                <i class="bi bi-envelope me-2"></i>
                <a href="mailto:[email]">[email]</a>
              </p>
            </div>
          </div>

          <!-- Identitas Diri Card -->
          <div class="card shadow-sm mb-4">
            <div class="card-body">
              <h5 class="section-title">
                <i class="bi bi-person-badge me-2"></i>{t.personal_identity}
              </h5>
              <div class="row g-3">
                <div class="col-12">
                  <div class="info-label">{t.name}</div>
                  <div class="info-value">[nama]</div>
                </div>
                <div class="col-12">
                  <div class="info-label">{t.employee_number}</div>
                  <div class="info-value">[nomor_pegawai]</div>
                </div>
                <div class="col-12">
                  <div class="info-label">{t.nidn}</div>
                  <div class="info-value">[nidn]</div>
                </div>
                <div class="col-12">
                  <div class="info-label">{t.nuptk}</div>
                  <div class="info-value">[nuptk]</div>
                </div>
                <div class="col-12">
                  <div class="info-label">{t.gender}</div>
                  <div class="info-value">[jenis_kelamin]</div>
                </div>
                <div class="col-12">
                  <div class="info-label">{t.email}</div>
                  <div class="info-value">
                    <a href="mailto:[email]">[email]</a>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Informasi Akademik Card -->
          <div class="card shadow-sm mb-4">
            <div class="card-body">
              <h5 class="section-title">
                <i class="bi bi-mortarboard me-2"></i>{t.academic_information}
              </h5>
              <div class="row g-3">
                <div class="col-12">
                  <div class="info-label">{t.field_of_study}</div>
                  <div class="info-value">[bidang_ilmu]</div>
                </div>
                <div class="col-12">
                  <div class="info-label">{t.education}</div>
                  <div class="info-value">[pendidikan]</div>
                </div>
                <div class="col-12">
                  <div class="info-label">{t.homebase_faculty}</div>
                  <div class="info-value">[homebase_fakultas]</div>
                </div>
                <div class="col-12">
                  <div class="info-label">{t.homebase_study_program}</div>
                  <div class="info-value">[homebase_prodi]</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Informasi Kepegawaian Card -->
          <div class="card shadow-sm mb-4">
            <div class="card-body">
              <h5 class="section-title">
                <i class="bi bi-briefcase me-2"></i>{t.employment_information}
              </h5>
              <div class="row g-3">
                <div class="col-12">
                  <div class="info-label">{t.employment_status}</div>
                  <div class="info-value">[status_pegawai]</div>
                </div>
                <div class="col-12">
                  <div class="info-label">{t.functional_position}</div>
                  <div class="info-value">[jabatan_fungsional]</div>
                </div>
                <div class="col-12">
                  <div class="info-label">{t.work_status}</div>
                  <div class="info-value">[status_kerja]</div>
                </div>
                <div class="col-12">
                  <div class="info-label">{t.rank_grade}</div>
                  <div class="info-value">[pangkat_golongan]</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Penugasan Card -->
          <div class="card shadow-sm mb-4">
            <div class="card-body">
              <h5 class="section-title">
                <i class="bi bi-clipboard-check me-2"></i>{t.assignment}
              </h5>
              <div class="row g-3">
                <div class="col-12">
                  <div class="info-label">{t.assignment_faculty}</div>
                  <div class="info-value">[penugasan_fakultas]</div>
                </div>
                <div class="col-12">
                  <div class="info-label">{t.assignment_study_program}</div>
                  <div class="info-value">[penugasan_prodi]</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </template>
</Layout>

<script>
  import "@components/customComponents/imgAutoBGColor";
  import "@components/customComponents/swalDetailButton";
</script>
<style is:global>
  /* ====== CARD ====== */
  .staff-detail .card {
    border: 1px solid #e5e7eb;
    background-color: #ffffff;
  }

  .staff-detail .card-body {
    background-color: #fafafa;
    font-size: 1rem;
    line-height: 1.5;
  }

  /* ====== HEADER UTAMA ====== */
  .staff-detail .card-header {
    background: linear-gradient(90deg, #0d6efd, #3759ff);
    color: #fff;
  }

  .staff-detail .card-header h4 {
    font-size: 1.4rem;
    font-weight: 600;
    color: #fff;
  }

  /* ====== SECTION TITLE ====== */
  .container.staff-detail .section-title {
    font-size: 1.2rem;
    font-weight: 600;
    color: #0d6efd;
    margin-bottom: 15px;
    padding-bottom: 10px;
    border-bottom: 2px solid #e9ecef;
  }

  /* ====== LABEL & VALUE ====== */
  .container.staff-detail .info-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: #6c757d;
    margin-bottom: 5px;
  }

  .container.staff-detail .info-value {
    font-size: 1rem;
    font-weight: 500;
    color: #212529;
  }

  /* ====== LINK ====== */
  .staff-detail a {
    font-size: 1rem;
    color: #0d6efd;
    text-decoration: none;
  }

  .staff-detail a:hover {
    color: #0a58ca;
    text-decoration: underline;
  }

  /* ====== ICON ====== */
  .staff-detail i {
    color: #2563eb;
  }

  /* ====== RESPONSIVE ====== */
  @media (max-width: 576px) {
    .staff-detail .card-header h4 {
      font-size: 1.2rem;
    }
    .container.staff-detail .section-title {
      font-size: 1.05rem;
    }
    .container.staff-detail .info-value {
      font-size: 0.95rem;
    }
  }
</style>
