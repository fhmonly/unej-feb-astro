---

import { getLocale, useI18n } from "@/i18n/i18n";
import PageTitleTypography from "@components/widgets/pageTitleTypography.astro";
import Layout from "@layouts/main.astro";


const messages = {
  en: {
    pageTitle: 'Conferences',
    title: 'Conferences',
  },
  id: {
    pageTitle: 'Konferensi',
    title: 'Konferensi',
  },
}

const t = useI18n(messages, getLocale(Astro))

// dummy data (bisa diganti API / content collection)
const conferences = [
  {
    name: 'ICBM 2023',
    posts: Array.from({ length: 2 }).map((_, i) => ({
      date: `${i + 1} August 2021`,
      title: 'Lorem ipsum dolor sit.',
      excerpt:
        'Lorem ipsum dolor, sit amet consectetur adipisicing elit. Modi voluptatibus ex itaque molestias voluptatum explicabo magni corporis illum ipsa doloribus!',
      image: 'https://via.placeholder.com/800x570',
      href: '#',
    })),
  },
  {
    name: 'ICEBAST 2025',
    posts: Array.from({ length: 2 }).map((_, i) => ({
      date: `${i + 1} August 2021`,
      title: 'Lorem ipsum dolor sit.',
      excerpt:
        'Lorem ipsum dolor, sit amet consectetur adipisicing elit. Modi voluptatibus ex itaque molestias voluptatum explicabo magni corporis illum ipsa doloribus!',
      image: 'https://via.placeholder.com/800x570',
      href: '#',
    })),
  },
]
---
<Layout title={t.pageTitle} >
  
<!-- start page title -->
 <PageTitleTypography title={t.pageTitle} image="/_astro/images/bg-feb.webp" />
<!-- end page title -->

<div id="down-section">
  {conferences.map((conf) => (
    <>
      <!-- conference title -->
      <section class="pt-5 pb-0">
        <div class="container">
          <div class="row align-items-center justify-content-center">
            <div class="col-12 col-xl-6 col-lg-8 text-center position-relative page-title-double-large">
              <h1 class="text-dark-gray alt-font ls-minus-1px fw-700">
                {conf.name}
              </h1>
            </div>
          </div>
        </div>
      </section>

      <!-- start conferences content -->
      <section class="p-0 ps-15 pe-15 xl-ps-2 xl-pe-2 lg-ps-2 lg-pe-2 sm-mx-0">
        <div class="container-fluid">
          <div class="row">
            <div class="col-12">
              <ul class="blog-classic blog-wrapper grid-loading grid grid-2col xl-grid-2col lg-grid-3col md-grid-2col sm-grid-2col xs-grid-1col gutter-extra-large">
                <li class="grid-sizer"></li>

                {conf.posts.map((post) => (
                  <li class="grid-item">
                    <div class="card bg-transparent border-0 h-100">
                      <div class="blog-image position-relative overflow-hidden border-radius-4px">
                        <a href={post.href}>
                          <img src={post.image} alt="" />
                        </a>
                      </div>

                      <div class="card-body px-0 pt-2 pb-2">
                        <span class="fs-13 text-uppercase mb-5px d-block">
                          <a href="#" class="blog-date text-dark-gray-hover">
                            {post.date}
                          </a>
                        </span>

                        <a
                          href={post.href}
                          class="card-title mb-10px fw-600 fs-17 lh-26 text-dark-gray text-dark-gray-hover d-inline-block w-95"
                        >
                          {post.title}
                        </a>

                        <p class="mb-10px w-95">{post.excerpt}</p>

                        <a
                          href={post.href}
                          class="card-link alt-font fs-12 text-uppercase text-dark-gray text-dark-gray-hover fw-700"
                        >
                          More reading
                          <i class="feather icon-feather-arrow-right icon-very-small"></i>
                        </a>
                      </div>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>
      <!-- end conferences content -->
    </>
  ))}
</div>

</Layout>