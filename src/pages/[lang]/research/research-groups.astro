---
import ContentRenderer from "@/components/widgets/content/contentRenderer.astro";
import PageTitleTypography from "@/components/widgets/pageTitleTypography.astro";
import { getLocale, useI18n } from "@/i18n/i18n";
import { researchGroupService } from "@/services/researchGroup.service";
import Layout from "@layouts/main.astro";

const t = useI18n(
  {
    en: {
      pageTitle: "Research Groups",
      title: "Research Groups",
    },
    id: {
      pageTitle: "Grup Penelitian",
      title: "Grup Penelitian",
    },
  },
  getLocale(Astro),
);

const rgsGetResearchGroups = await researchGroupService.getResearchGroups();
const items = rgsGetResearchGroups?.data;
---

<Layout title={t.pageTitle}>
  <PageTitleTypography title={t.pageTitle} image="/_astro/images/bg-feb.webp" />

  <!-- CONTENT -->
  <section id="down-section">
    <div class="container overlap-gap-section">
      <div class="row mb-5 text-center text-lg-start">
        <div class="col-xl-5 col-lg-6 col-md-10">
          <h3 class="text-dark-gray fw-700 mb-0">
            {t.title}
          </h3>
        </div>
      </div>

      <ContentRenderer showContent={!!items?.length}>
        <div
          class="row row-cols-1 row-cols-lg-4 row-cols-md-4 row-cols-sm-2 gap-3"
        >
          {
            items?.map((v) => (
              <div class="bg-white box-shadow-quadruple-large border-radius-4px overflow-hidden">
                <div class="p-40px lg-p-30px">
                  <span class="fs-24 alt-font text-dark-gray fw-700 d-block mb-2">
                    {v.nama}
                  </span>
                  <p>{v.deskripsi}</p>
                </div>

                <div class="bg-dark-gray p-15px text-center">
                  <a href="#" class="text-white fw-500">
                    {v.links}
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </ContentRenderer>
    </div>
  </section>
</Layout>
