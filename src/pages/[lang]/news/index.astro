---
import { getLocale, useI18n } from "@/i18n/i18n";
import { newsService } from "@/services/news.service";
import ModulesNewsCard from "@components/modules/news/card.astro";
import PageTitleTypography from "@components/widgets/pageTitleTypography.astro";
import WidgetsPagination from "@components/widgets/pagination.astro";
import Layout from "@layouts/main.astro";

const locale = getLocale(Astro);
const page = Number(Astro.url.searchParams.get("page") ?? 1);

const t = useI18n(
  {
    en: {
      pageTitle: "News",
      title: "News",
    },
    id: {
      pageTitle: "Berita",
      title: "Berita",
    },
  },
  locale,
);

const nsGetNews = await newsService.getNews({ page });
const data = nsGetNews?.data;
if (!data) {
  return Astro.rewrite("/404");
}
---

<Layout title={t.pageTitle}>
  <PageTitleTypography title={t.pageTitle} image="/_astro/images/bg-feb.webp" />
  <section id="down-section">
    <div class="container">
      <div class="row">
        <div class="col-12 px-0">
          <ul
            class="blog-classic blog-wrapper grid-loading grid grid-4col xl-grid-4col lg-grid-3col md-grid-2col sm-grid-2col xs-grid-1col gutter-double-extra-large"
          >
            <li class="grid-sizer"></li>

            {
              data.results.map((news) => (
                <li class="grid-item">
                  <ModulesNewsCard
                    date={news.tanggal}
                    title={news.judul}
                    newsType={news.kategori.nama}
                    image={news.gambar_unggulan}
                    id={news.id}
                  />
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="row">
        <div class="col-12 mt-2 d-flex justify-content-center">
          <WidgetsPagination
            currentPage={page}
            perPage={data.results.length}
            total={data.count}
            basePath={`/${getLocale(Astro)}/news`}
          />
        </div>
      </div>
    </div>
  </section>
</Layout>
