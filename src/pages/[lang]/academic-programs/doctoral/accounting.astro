---
import ContentContainer from "@/components/widgets/contentContainer.astro";
import PageSection from "@/components/widgets/pageSection.astro";
import PageTitleTypography from "@/components/widgets/pageTitleTypography.astro";
import { getLocale, useI18n } from "@/i18n/i18n";
import NewsCard from "@components/modules/news/card.astro";
import PillDivider from "@components/widgets/pillDivider.astro";
import Layout from "@layouts/prodi.astro";

const locale = getLocale(Astro);

const pageJson = {
  en: {
    pageTitle: "Doctor of Accounting",

    // table headers
    accredited: "Accredited",
    accreditationBoard: "Accreditation Board",
    startDate: "Start",
    endDate: "End",

    // accreditation section
    accreditationBadge: "Accreditation",
    accreditationHeading: "We’re achieving recognition and awards.",

    information: "Information",
    important_information_access: "Access Important Information",
    news: "News",
    view_more: "View More",

    academicRequirements: "Academic Requirements",
    graduateProfile: "Graduate Profile",
    curriculum: "Curriculum",
  },
  id: {
    pageTitle: "Doktor Ilmu Akuntansi",

    // table headers
    accredited: "Akreditasi",
    accreditationBoard: "Badan Akreditasi",
    startDate: "Mulai",
    endDate: "Berakhir",

    // accreditation section
    accreditationBadge: "Akreditasi",
    accreditationHeading: "Kami meraih pengakuan dan penghargaan.",

    information: "Informasi",
    important_information_access: "Akses Informasi Penting",
    news: "Berita",
    view_more: "Lihat Lebih Banyak",

    academicRequirements: "Ketentuan Akademik",
    graduateProfile: "Profil Lulusan",
    curriculum: "Kurikulum",
  },
};

const visionMissionJson = {
  en: {
    vision:
      "To become an excellent doctoral program in accounting science that is internationally recognized and contributes to the development of accounting theory, practice, and policy",

    missions: [
      {
        title: "Doctoral Education",
        body: "Organizing high-quality doctoral education in accounting science to produce graduates with strong theoretical mastery, critical thinking, and research capabilities at the international level",
      },
      {
        title: "Research and Scientific Development",
        body: "Conducting innovative and impactful research in accounting, including financial accounting, management accounting, auditing, taxation, and public sector accounting, with international publications",
      },
      {
        title: "Academic and Scientific Activities",
        body: "Developing academic activities that support the advancement of accounting science and respond to global, national, and societal challenges",
      },
      {
        title: "International Collaboration and Networking",
        body: "Expanding international collaboration and networking with academic institutions, professional bodies, and research organizations in the field of accounting",
      },
    ],
  },

  id: {
    vision:
      "Menjadi program doktor yang unggul dan berdaya saing internasional dalam pengembangan ilmu akuntansi serta berkontribusi terhadap pengembangan teori, praktik, dan kebijakan akuntansi",

    missions: [
      {
        title: "Pendidikan Doktoral",
        body: "Menyelenggarakan pendidikan program doktor di bidang ilmu akuntansi yang berkualitas untuk menghasilkan lulusan dengan penguasaan teori, kemampuan berpikir kritis, dan kompetensi riset bertaraf internasional",
      },
      {
        title: "Penelitian dan Pengembangan Keilmuan",
        body: "Melaksanakan penelitian dan pengembangan ilmu akuntansi yang inovatif dan berdampak, mencakup akuntansi keuangan, akuntansi manajemen, auditing, perpajakan, dan akuntansi sektor publik, serta publikasi internasional",
      },
      {
        title: "Kegiatan Akademik dan Keilmuan",
        body: "Mengembangkan kegiatan akademik dan keilmuan yang mendukung kemajuan ilmu akuntansi serta menjawab tantangan global, nasional, dan kebutuhan masyarakat",
      },
      {
        title: "Kerja Sama dan Jejaring Internasional",
        body: "Memperluas kerja sama dan jejaring internasional dengan institusi akademik, organisasi profesi, dan lembaga riset di bidang akuntansi",
      },
    ],
  },
};

const prodiObjective = {
  en: {
    prodi_objective: "Department Objective",
    objectives: [
      "Have expertise in the science of development planning and professional agro-industry-based regional development",
      "Student are able to develop knowledge and solve problems in the field of development planning and regional development based on agro-industry, and able to produce innovative and tested works",
      "Student are able to produce a variety of new ideas and quality scientific work in the field of agro-industry-based development planning and regional development and be able to disseminate them to gain recognition at the international level",
    ],
  },
  id: {
    prodi_objective: "Tujuan Prodi",
    objectives: [
      "Memiliki kepakaran dalam keilmuan perencanaan pembangunan dan pengembangan wilayah berbasis agroindustri yang profesional",
      "Mampu mengembangkan pengetahuan dan memecahkan permasalahan di bidang perencanaan pembangunan dan pengembangan wilayah berbasis agroindustri, serta mampu menghasilkan karya yang inovatif dan teruji",
      "Mampu menghasilkan berbagai gagasan baru dan karya ilmiah bermutu di bidang perencanaan pembangunan dan pengembangan wilayah berbasis agroindustri serta mampu mendiseminasikannya untuk mendapat rekognisi pada level Internasional",
    ],
  },
};

const mergedJson = {
  en: {
    ...pageJson.en,
    ...visionMissionJson.en,
    ...prodiObjective.en,
  },
  id: {
    ...pageJson.id,
    ...visionMissionJson.id,
    ...prodiObjective.id,
  },
};

const t = useI18n(mergedJson, locale);

import dayjs from "dayjs";
import "dayjs/locale/id";

dayjs.locale(locale);
const accreditation = [
  {
    accredited: "Unggul",
    accreditationBoard: "BAN-PT",
    start: "2024-04-16",
    end: "2025-11-17",
    file: "https://feb.unej.ac.id/assets/akreditasi/akreditasi_20240418145740.png",
  },
];

const accreditationList = accreditation.map((item) => {
  return {
    accredited: item.accredited,
    accreditationBoard: item.accreditationBoard,
    start: dayjs(item.start).format("DD MMMM YYYY"),
    end: dayjs(item.end).format("DD MMMM YYYY"),
    file: item.file,
  };
});
---

<Layout title={t.pageTitle}>
  <PageTitleTypography title={t.pageTitle} image="/_astro/images/bg-feb.webp" />
  <section class="bg-very-light-gray">
    <div class="container position-relative z-index-1">
      <div class="row justify-content-center mb-30px">
        <div
          class="col-xl-7 col-lg-8 col-md-10 text-center"
          data-anime='{ "el": "childs", "translateY": [30, 0], "opacity": [0,1], "duration": 600, "delay":0, "staggervalue": 300, "easing": "easeOutQuad" }'
        >
          <div
            class="fs-11 lh-26 fw-500 text-uppercase text-white bg-majorelle-blue border-radius-30px ps-15px pe-15px mb-20px d-inline-block"
          >
            {t.accreditationBadge}
          </div>
          <h2 class="fw-600 ls-minus-2px text-dark-gray">
            {t.accreditationHeading}
          </h2>
        </div>
      </div>
      <div class="row">
        <div
          class="col-12"
          data-anime='{ "el": "childs", "translateY": [30, 0], "opacity": [0,1], "duration": 600, "delay":0, "staggervalue": 300, "easing": "easeOutQuad" }'
        >
          {
            accreditationList.map((item, index) => (
              <div class="row g-0 align-items-center text-center text-sm-start">
                <div class="col-12">
                  <div class="separator-line-5px w-100 bg-medium-gray opacity-3 bg-sliding-line" />
                </div>

                {/* number */}
                <div class="col-sm-1 text-center xs-mt-20px">
                  <span class="text-dark-gray fs-16 ls-minus-1px fw-600">
                    {(index + 1).toString().padStart(2, "0")}
                  </span>
                </div>

                {/* title -> accredited */}
                <div class="col-sm-3 offset-sm-1">
                  <span class="fw-600 text-dark-gray fs-22 ls-minus-05px">
                    <a href={item.file} target="_blank">
                      {item.accredited}
                      <i class="fa-solid fa-arrow-up-right-from-square inline-block ms-3" />
                    </a>
                  </span>
                </div>

                {/* content -> board + date */}
                <div class="col-sm-7 p-35px sm-p-25px xs-p-20px xs-pt-10px last-paragraph-no-margin">
                  <p class="w-95 sm-w-100">
                    {item.accreditationBoard} <br />
                    {item.start} – {item.end}
                  </p>
                </div>
              </div>
            ))
          }

          {/* closing separator */}
          <div class="row g-0">
            <div class="col-12">
              <div
                class="separator-line-5px w-100 bg-medium-gray opacity-3 bg-sliding-line"
              >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-solitude-blue">
    <div class="container">
      <div class="row justify-content-center">
        <div
          class="col-xl-5 col-lg-6 md-mb-50px sm-mb-20px"
          data-anime='{ "el": "childs", "translateY": [50, 0], "opacity": [0,1], "duration": 600, "delay": 0, "staggervalue": 300, "easing": "easeOutQuad" }'
        >
          <h3
            class="text-dark-gray fw-600 ls-minus-1px mb-20px sm-w-85 xs-w-100"
          >
            Vision & Mission
          </h3>
          <p>
            Becoming a superior vocational study program in developing the field
            of corporate management that is adaptive and environmentally
            friendly and agro-industry at the international level
          </p>
          <div class="row row-cols-1 mt-40px">
            <!-- start process step item -->
            {
              t.missions.map((v, i) => (
                <div class="col-12 process-step-style-05 position-relative hover-box">
                  <div class="process-step-item d-flex">
                    <div class="process-step-icon-wrap position-relative">
                      <div class="process-step-icon d-flex justify-content-center align-items-center mx-auto rounded-circle h-60px w-60px bg-light-red-grey fs-14 fw-600 position-relative">
                        <span class="number position-relative z-index-1 text-dark-gray">
                          {i < 9
                            ? "0" + (i + 1)
                            : (i + 1).toString().padStart(2, "0")}
                        </span>
                        <div class="box-overlay bg-base-color rounded-circle" />
                      </div>
                      {i < t.missions.length - 1 && (
                        <span class="progress-step-separator bg-extra-medium-gray" />
                      )}
                    </div>
                    <div class="process-content ps-30px last-paragraph-no-margin mb-40px">
                      <span class="d-block fw-600 text-dark-gray mb-5px fs-18 ls-minus-05px">
                        {v.title}
                      </span>
                      <p class="w-85 lg-w-100">{v.body}</p>
                    </div>
                  </div>
                </div>
              ))
            }
            <!-- end process step item -->
          </div>
        </div>
        <div
          class="col-xl-6 col-lg-6 offset-xl-1 position-relative md-mb-50px position-sticky top-120px"
          style="height: fit-content;"
        >
          <div
            class="text-end w-80 md-w-75 ms-auto"
            data-animation-delay="500"
            data-shadow-animation="true"
            data-bottom-top="transform: translateY(50px)"
            data-top-bottom="transform: translateY(-50px)"
          >
            <img
              src="https://psd3mp.feb.unej.ac.id/assets/theme/img/preview.webp"
              alt=""
              class="border-radius-5px"
            />
          </div>
          <div
            class="w-60 md-w-50 xs-w-55 overflow-hidden position-absolute left-15px bottom-minus-50px"
            data-shadow-animation="true"
            data-animation-delay="500"
            data-bottom-top="transform: translateY(-50px)"
            data-top-bottom="transform: translateY(50px)"
          >
            <img
              src="https://psd3mp.feb.unej.ac.id/assets/theme/img/preview.webp"
              alt=""
              class="border-radius-5px box-shadow-quadruple-large"
            />
          </div>
        </div>
      </div>
    </div>
    <div class="my-5">&nbsp;</div>
    <div class="container mt-5">
      <div class="d-flex justify-content-center">
        <div style="max-width: 998px;">
          <h4
            class="text-dark-gray fw-700 ls-minus-1px alt-font mb-40px lg-mb-30px d-block text-center"
          >
            {t.prodi_objective}
          </h4>
          <div
            class="border border-color-extra-medium-gray border-radius-6px mb-40px xs-mb-30px overflow-hidden"
          >
            {
              t.objectives.map((item, index) => (
                <p class="ps-30px pe-30px pt-25px pb-25px border-bottom border-1 border-color-extra-medium-gray mb-0">
                  {item}
                </p>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
  <PageSection title={t.information}>
    <PillDivider
      icon="fa-regular fa-newspaper"
      text={t.academicRequirements}
      class="mb-3"
    />
    <ContentContainer class="my-3 py-5" />
    <PillDivider
      icon="fa-regular fa-newspaper"
      text={t.graduateProfile}
      class="mb-3"
    />
    <ContentContainer class="my-3 py-5" />
    <PillDivider
      icon="fa-regular fa-newspaper"
      text={t.curriculum}
      class="mb-3"
    />
    <ContentContainer class="my-3 py-5" />
  </PageSection>
  <PageSection
    title={t.important_information_access}
    class="overflow-hidden bg-very-light-gray position-relative"
  >
    <div
      class="row align-items-center"
      data-anime='{ "opacity": [0,1], "duration": 600, "delay":0, "staggervalue": 300, "easing": "easeOutQuad" }'
    >
      <div class="col-12">
        <div class="outside-box-right-20 sm-outside-box-right-0">
          <div
            class="swiper magic-cursor drag-cursor slider-one-slide"
            data-slider-options='{ "slidesPerView": 1, "spaceBetween": 30, "loop": true, "navigation": { "nextEl": ".slider-one-slide-next-1", "prevEl": ".slider-one-slide-prev-1" }, "autoplay": { "delay": 4000, "disableOnInteraction": false }, "keyboard": { "enabled": true, "onlyInViewport": true }, "breakpoints": { "1200": { "slidesPerView": 4 }, "992": { "slidesPerView": 3 }, "768": { "slidesPerView": 2 }, "320": { "slidesPerView": 1 } }, "effect": "slide" }'
          >
            <div class="swiper-wrapper">
              {
                Array.from({ length: 8 }).map((_, i) => (
                  <div class="swiper-slide">
                    <div class="services-box-style-03 last-paragraph-no-margin border-radius-6px overflow-hidden">
                      <div class="bg-white">
                        <div class="ps-65px pe-65px pt-30px pb-30px text-center">
                          <a
                            href="#"
                            class="d-inline-block fs-18 fw-600 text-dark-gray mb-5px"
                          >
                            Service title {i + 1}
                          </a>
                          <p>
                            Lorem ipsum simply dummy text of amet consectetur.
                          </p>
                        </div>

                        <div class="d-flex justify-content-center border-top border-color-extra-medium-gray pt-20px pb-20px ps-50px pe-50px position-relative text-center">
                          <a
                            href="#"
                            class="btn btn-link btn-hover-animation-switch btn-medium fw-700 text-dark-gray text-uppercase"
                          >
                            <span>
                              <span class="btn-text">Explore services</span>
                              <span class="btn-icon">
                                <i class="fa-solid fa-arrow-right" />
                              </span>
                              <span class="btn-icon">
                                <i class="fa-solid fa-arrow-right" />
                              </span>
                            </span>
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- <p>Haloo</p> -->
  </PageSection>
  <PageSection title={t.news}>
    <div class="row">
      <div class="col-12 px-0">
        <ul
          class="blog-classic blog-wrapper grid-loading grid grid-4col xl-grid-4col lg-grid-3col md-grid-2col sm-grid-2col xs-grid-1col gutter-double-extra-large"
          data-anime='{ "el": "childs", "translateY": [50, 0], "opacity": [0,1], "duration": 1200, "delay": 0, "staggervalue": 150, "easing": "easeOutQuad" }'
        >
          <li class="grid-sizer"></li>
          {
            Array.from({ length: 4 }).map((_, i) => (
              <li class="grid-item">
                <NewsCard
                  date={`2025-10-${i}`}
                  desc="Desc: Lorem ipsum dolor, sit amet consectetur adipisicing elit. Qui, quod!"
                  newsType="Achievement News"
                  title="Congrats!!"
                  image="https://plus.unsplash.com/premium_photo-1664474619075-644dd191935f?fm=jpg&q=60&w=3000&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MXx8aW1hZ2V8ZW58MHx8MHx8fDA%3D"
                  slug={`congrats-${i}`}
                />
              </li>
            ))
          }
        </ul>
      </div>
      <div class="d-flex justify-content-center mt-3">
        <a
          href="#"
          class="btn btn-large btn-rounded with-rounded btn-white btn-box-shadow fw-600"
        >
          {t.view_more}
          <span class="bg-base-color text-white">
            <i class="bi bi-arrow-right-short icon-extra-medium"></i>
          </span>
        </a>
      </div>
    </div>
  </PageSection>
</Layout>
