---
import ContentContainer from "@/components/widgets/contentContainer.astro";
import PageSection from "@/components/widgets/pageSection.astro";
import PageTitleTypography from "@/components/widgets/pageTitleTypography.astro";
import { getLocale, useI18n } from "@/i18n/i18n";
import ModulesAboutLeaderCard from "@components/modules/about/leaderCard.astro";
import PillDivider from "@components/widgets/pillDivider.astro";
import Layout from "@layouts/prodi.astro";
const locale = getLocale(Astro);

const pageJson = {
  en: {
    pageTitle: "Doctor of Accounting",

    // table headers
    accredited: "Accredited",
    accreditationBoard: "Accreditation Board",
    startDate: "Start",
    endDate: "End",

    // accreditation section
    accreditationBadge: "Accreditation",
    accreditationHeading: "We’re achieving recognition and awards.",

    information: "Information",
    important_information_access: "Access Important Information",
    news: "News",
    view_more: "View More",

    academicRequirements: "Academic Requirements",
    graduateProfile: "Graduate Profile",
    curriculum: "Curriculum",
  },
  id: {
    pageTitle: "Doktor Ilmu Akuntansi",

    // table headers
    accredited: "Akreditasi",
    accreditationBoard: "Badan Akreditasi",
    startDate: "Mulai",
    endDate: "Berakhir",

    // accreditation section
    accreditationBadge: "Akreditasi",
    accreditationHeading: "Kami meraih pengakuan dan penghargaan.",

    information: "Informasi",
    important_information_access: "Akses Informasi Penting",
    news: "Berita",
    view_more: "Lihat Lebih Banyak",

    academicRequirements: "Ketentuan Akademik",
    graduateProfile: "Profil Lulusan",
    curriculum: "Kurikulum",
  },
};

const visionMissionJson = {
  en: {
    vision:
      "To become an excellent doctoral program in accounting science that is internationally recognized and contributes to the development of accounting theory, practice, and policy",

    missions: [
      {
        title: "Doctoral Education",
        body: "Organizing high-quality doctoral education in accounting science to produce graduates with strong theoretical mastery, critical thinking, and research capabilities at the international level",
      },
      {
        title: "Research and Scientific Development",
        body: "Conducting innovative and impactful research in accounting, including financial accounting, management accounting, auditing, taxation, and public sector accounting, with international publications",
      },
      {
        title: "Academic and Scientific Activities",
        body: "Developing academic activities that support the advancement of accounting science and respond to global, national, and societal challenges",
      },
      {
        title: "International Collaboration and Networking",
        body: "Expanding international collaboration and networking with academic institutions, professional bodies, and research organizations in the field of accounting",
      },
    ],
  },

  id: {
    vision:
      "Menjadi program doktor yang unggul dan berdaya saing internasional dalam pengembangan ilmu akuntansi serta berkontribusi terhadap pengembangan teori, praktik, dan kebijakan akuntansi",

    missions: [
      {
        title: "Pendidikan Doktoral",
        body: "Menyelenggarakan pendidikan program doktor di bidang ilmu akuntansi yang berkualitas untuk menghasilkan lulusan dengan penguasaan teori, kemampuan berpikir kritis, dan kompetensi riset bertaraf internasional",
      },
      {
        title: "Penelitian dan Pengembangan Keilmuan",
        body: "Melaksanakan penelitian dan pengembangan ilmu akuntansi yang inovatif dan berdampak, mencakup akuntansi keuangan, akuntansi manajemen, auditing, perpajakan, dan akuntansi sektor publik, serta publikasi internasional",
      },
      {
        title: "Kegiatan Akademik dan Keilmuan",
        body: "Mengembangkan kegiatan akademik dan keilmuan yang mendukung kemajuan ilmu akuntansi serta menjawab tantangan global, nasional, dan kebutuhan masyarakat",
      },
      {
        title: "Kerja Sama dan Jejaring Internasional",
        body: "Memperluas kerja sama dan jejaring internasional dengan institusi akademik, organisasi profesi, dan lembaga riset di bidang akuntansi",
      },
    ],
  },
};

const aboutProdi = {
  en: {
    about_prodi_title: "About Study Program",
    about_prodi: [
      "The Doctoral Program in Accounting (Ph.D. in Accounting) was established based on the Decree of the Minister of Higher Education, Science, and Technology Number 1202/B/0/2025 concerning the Authorization to Open the Doctoral Program in Accounting, dated 24 December 2025.",
      "The Doctoral Program in Accounting is administered by the Department of Accounting, Faculty of Economics and Business, Universitas Jember, and is organized through the Faculty. The program is conducted using a by-research approach over six semesters (three years) with a total academic load of 42 credits.",
      "The distinctive strength of the Doctoral Program in Accounting lies in its focus on sustainability accounting, aimed at addressing, fulfilling, and adapting to the evolving needs, demands, and challenges of industrial and non-industrial sectors, government and non-government institutions, as well as social, environmental, and community contexts that continue to change dynamically.",
      "The Doctoral Program in Accounting at Universitas Jember is designed to produce graduates who are capable of positioning themselves as agents of development in accounting science, in order to meet the needs and expectations of society, government, business, and industry. Furthermore, the program is structured to respond to stakeholder demands in academic, industrial, governmental, and societal sectors by contributing to the enhancement of scientific quality, the development of accounting technologies, improved financial governance, and community empowerment.",
    ],
  },
  id: {
    about_prodi_title: "Tentang Prodi",
    about_prodi: [
      "Program studi doktor ilmu akuntansi atau S3 ilmu akuntansi didirikan berdasarkan Keputusan Menteri Pendidikan Tinggi, Sains, dan Teknologi Nomor 1202/B/0/2025 Izin Pembukaan Program Studi Ilmu Akuntansi Program Doktor tertanggal24 Desember 2025.",
      "Program studi S3 ilmu akuntansi diselenggarakan oleh Jurusan Akuntansi Fakultas Ekonomi dan Bisnis dan Universitas Jember melalui Fakultas. Program studi doktor ilmu akuntansi diselenggarakan dengan  metode by research  selama 6 semester ( 3 tahun ) dengan jumlah SKS  sebanyak 42.",
      "Kunikan atau keunggulan dari Program studi S3 ilmu Akuntansi pada akuntansi keberlanjutan untuk menjawab, memenuhi dan menyesuaikan  kebutuhan, tuntutan dan tantangan dunia industri dan non industri, pemerintah dan non pemerintah , masyarakat, lingkungan dan sosial yang selalu berubah dan bergerak.",
      "Program Studi Doktor Ilmu Akuntansi Universitas Jember memiliki keunggulan untuk menghasilkan lulusan yang mampu memposisikan perannya sebagai agen pengembangan dalam ilmu akuntansi dalam rangka memenuhi kebutuhan dan keinginan masyarakat, pemerintah, dunia usaha, dan industri.Program Studi Doktor Ilmu Akuntansi di FEB UNEJ dirancang untuk menjawab kebutuhan stakeholders, baik di bidang akademik, industri, pemerintah, maupun masyarakat luas dengan berkontribusi pada peningkatan kualitas keilmuan, pengembangan teknologi akuntansi, tata kelola keuangan yang lebih baik, serta pemberdayaan masyarakat.",
    ],
  },
};

const mergedJson = {
  en: {
    ...pageJson.en,
    ...visionMissionJson.en,
    ...aboutProdi.en,
  },
  id: {
    ...pageJson.id,
    ...visionMissionJson.id,
    ...aboutProdi.id,
  },
};

const t = useI18n(mergedJson, locale);

import dayjs from "dayjs";
import "dayjs/locale/id";

dayjs.locale(locale);
const accreditation = [
  {
    accredited: "Unggul",
    accreditationBoard: "BAN-PT",
    start: "2024-04-16",
    end: "2025-11-17",
    file: "https://www2.feb.unej.ac.id/assets/akreditasi/akreditasi_20240418145740.png",
  },
];

const accreditationList = accreditation.map((item) => {
  return {
    accredited: item.accredited,
    accreditationBoard: item.accreditationBoard,
    start: dayjs(item.start).format("DD MMMM YYYY"),
    end: dayjs(item.end).format("DD MMMM YYYY"),
    file: item.file,
  };
});
---

<Layout title={t.pageTitle}>
  <PageTitleTypography title={t.pageTitle} image="/_astro/images/bg-feb.webp" />
  <!-- <section class="bg-very-light-gray">
    <div class="container position-relative z-index-1">
      <div class="row justify-content-center mb-30px">
