---
import ProdiNewsPreview from "@/components/modules/academicPrograms/ProdiNewsPreview.astro";
import ContentRenderer from "@/components/widgets/content/contentRenderer.astro";

import ListProcess from "@/components/widgets/list/ListProcess.astro";
import PageSection from "@/components/widgets/pageSection.astro";
import PageTitleTypography from "@/components/widgets/pageTitleTypography.astro";
import { getLocale, useI18n } from "@/i18n/i18n";
import PillDivider from "@components/widgets/pillDivider.astro";
import Layout from "@layouts/prodi.astro";

const locale = getLocale(Astro);

const pageJson = {
  en: {
    pageTitle: "Development Economics",

    // table headers
    accredited: "Accredited",
    accreditationBoard: "Accreditation Board",
    startDate: "Start",
    endDate: "End",

    // accreditation section
    accreditationBadge: "Accreditation",
    accreditationHeading: "We’re achieving recognition and awards.",

    information: "Information",
    important_information_access: "Access Important Information",
    news: "News",
    view_more: "View More",

    academicRequirements: "Academic Requirements",
    graduateProfile: "Graduate Profile",
    curriculum: "Curriculum",
  },
  id: {
    pageTitle: "Ekonomi Pembangunan",

    // table headers
    accredited: "Akreditasi",
    accreditationBoard: "Badan Akreditasi",
    startDate: "Mulai",
    endDate: "Berakhir",

    // accreditation section
    accreditationBadge: "Akreditasi",
    accreditationHeading: "Kami meraih pengakuan dan penghargaan.",

    information: "Informasi",
    important_information_access: "Akses Informasi Penting",
    news: "Berita",
    view_more: "Lihat Lebih Banyak",

    academicRequirements: "Ketentuan Akademik",
    graduateProfile: "Profil Lulusan",
    curriculum: "Kurikulum",
  },
};

const visionMissionJson = {
  en: {
    vision:
      "Becoming an Excellent Study Program in the Development of Environmental Economics and Agro-industry at the international level",
    missions: [
      {
        title: "Organizing Education",
        body: "Organizing education that produces graduates who are independent and innovative in the field of economics with environmental insight in order to produce graduates who work, are moral and pious to God Almighty, have an academic and professional attitude and have competitive advantage, adequate leadership skills, the ability to solve problems and adapt to the environment",
      },
      {
        title: "Applying Knowledge",
        body: "Applying knowledge to the planning and implementation of regional, national and international economic development, through the development of scientific studies on Regional Economics and Agribusiness (EWA), Human Resource Economics (ESDM) and Monetary Economics with an environmental perspective",
      },
      {
        title: "Building Synergies",
        body: "Building synergies with bureaucracy, practitioners and implementers of policy makers through structured, systematic, consistent and integrative discussions using scientific methods to solve empirical problems that occur in society regarding fields related to study programs",
      },
      {
        title: "Publication",
        body: "Publish the results of Higher Education's Tri Dharma activities which include teaching, research, community service through action studies and the application of economics, especially in developing Regional Economics and Agribusiness (EWA), Human Resource Economics (ESDM) and Monetary Economics with a sustainable environmental perspective.",
      },
    ],
  },
  id: {
    vision:
      "Menjadi Program Studi Unggul dalam Pengembangan Ilmu Ekonomi Berwawasan Lingkungan dan Agroindustri di level internasional",
    missions: [
      {
        title: "Menyelenggarakan Pendidikan",
        body: "Menyelenggarakan pendidikan yang menghasilkan lulusan yang mandiri dan inovatif dalam bidang ilmu ekonomi yang berwawasan lingkungan guna menghasilkan lulusan yang berkarya, bermoral dan bertaqwa pada Tuhan Yang Maha Esa, memiliki sikap akademik dan profesional serta mempunyai keunggulan kompetitif, kemampuan kepemimpinan yang memadai, kemampuan memecahkan masalah dan beradaptasi dengan lingkungan",
      },
      {
        title: "Menerapkan Ilmu Pengetahuan",
        body: "Menerapkan ilmu pengetahuan pada perencanaan dan pelaksanaan pembangunan ekonomi regional, nasional maupun internasional, melalui pengembangan kajian ilmiah mengenai Ekonomi Wilayah dan Agribisnis (EWA), Ekonomi Sumberdaya Manusia (ESDM) dan Ekonomi Moneter yang berwawasan lingkungan",
      },
      {
        title: "Membangun Sinergi",
        body: "Membangun sinergi dengan kalangan birokrasi, praktisi dan pelaksana pengambil kebijaksanaan melalui diskusi yang terstruktur, sistematis, konsisten dan integratif dengan menggunakan metode ilmiah untuk menyelesaikan masalah empiris yang terjadi di masyarakat menyangkut bidang yang terkait dengan program studi",
      },
      {
        title: "Publikasi",
        body: "Mempublikasikan hasil kegiatan Tri Dharma Perguruan Tinggi yang meliputi pengajaran, penelitian, pengabdian pada masyarakat melalui kaji tindak dan penerapan ilmu ekonomi, terutama dalam mengembangkan Ekonomi Wilayah dan Agribisnis (EWA), Ekonomi Sumber Daya Manusia (ESDM) dan Ekonomi Moneter yang berwawasan lingkungan yang berkelanjutan",
      },
    ],
  },
};

const prodiObjective = {
  en: {
    prodi_objective: "Department Objective",
    objectives: [
      "Able to internalize the attitude of piety to God Almighty",
      "Able to analyze the concepts of economic theory, economic mathematics and development economics that support environmentally sound agro-industry",
      "Able to solve problems using the concepts and principles of monetary economics, human resource economics, regional economics and agribusiness that support environmentally sound agro-industry",
      "Able to apply quantitative and qualitative techniques as well as knowledge of monetary economics, human resource economics, regional economics and agribusiness to solve environmental agro-industry problems",
      "Able to apply research methodology in economics",
    ],
  },
  id: {
    prodi_objective: "Tujuan Prodi",
    objectives: [
      "Mampu menginternalisasi sikap takwa kepada Tuhan Yang Maha Esa",
      "Mampu menganalisis konsep teori ekonomi, matematika ekonomi dan ekonomi pembangunan yang mendukung agroindustri berwawasan lingkungan",
      "Mampu menyelesaikan permasalahan dengan menggunakan konsep dan prinsip ekonomi moneter, ekonomi sumberdaya manusia, ekonomi wilayah dan agribisnis yang mendukung agroindustri berwawasan lingkungan",
      "Mampu menerapkan teknik kuantitatif dan kualitatif serta pengetahuan ekonomi moneter, ekonomi sumberdaya manusia, ekonomi wilayah dan agribisnis untuk menyelesaikan permasalahan agroindustri berwawasan lingkungan",
      "Mampu mengaplikasikan metodologi penelitian dalam ilmu ekonomi",
    ],
  },
};

const mergedJson = {
  en: {
    ...pageJson.en,
    ...visionMissionJson.en,
    ...prodiObjective.en,
  },
  id: {
    ...pageJson.id,
    ...visionMissionJson.id,
    ...prodiObjective.id,
  },
};

const t = useI18n(mergedJson, locale);

import dayjs from "dayjs";
import "dayjs/locale/id";

dayjs.locale(locale);
const accreditation = [
  {
    accredited: "Unggul",
    accreditationBoard: "BAN-PT",
    start: "2024-04-16",
    end: "2025-11-17",
    file: "https://www2.feb.unej.ac.id/assets/akreditasi/akreditasi_20240418145740.png",
  },
];

const accreditationList = accreditation.map((item) => {
  return {
    accredited: item.accredited,
    accreditationBoard: item.accreditationBoard,
    start: dayjs(item.start).format("DD MMMM YYYY"),
    end: dayjs(item.end).format("DD MMMM YYYY"),
    file: item.file,
  };
});
---

<Layout title={t.pageTitle}>
  <PageTitleTypography title={t.pageTitle} image="/_astro/images/bg-feb.webp" />
  <section class="bg-very-light-gray">
    <div class="container position-relative z-index-1">
      <div class="row justify-content-center mb-30px">
        <div
          class="col-xl-7 col-lg-8 col-md-10 text-center"
          data-anime='{ "el": "childs", "translateY": [30, 0], "opacity": [0,1], "duration": 600, "delay":0, "staggervalue": 300, "easing": "easeOutQuad" }'
        >
          <div
            class="fs-11 lh-26 fw-500 text-uppercase text-white bg-majorelle-blue border-radius-30px ps-15px pe-15px mb-20px d-inline-block"
          >
            {t.accreditationBadge}
          </div>
          <h2 class="fw-600 ls-minus-2px text-dark-gray">
            {t.accreditationHeading}
          </h2>
        </div>
      </div>
      <div class="row">
        <div
          class="col-12"
          data-anime='{ "el": "childs", "translateY": [30, 0], "opacity": [0,1], "duration": 600, "delay":0, "staggervalue": 300, "easing": "easeOutQuad" }'
        >
          {
            accreditationList.map((item, index) => (
              <div class="row g-0 align-items-center text-center text-sm-start">
                <div class="col-12">
                  <div class="separator-line-5px w-100 bg-medium-gray opacity-3 bg-sliding-line" />
                </div>

                {/* number */}
                <div class="col-sm-1 text-center xs-mt-20px">
                  <span class="text-dark-gray fs-16 ls-minus-1px fw-600">
                    {(index + 1).toString().padStart(2, "0")}
                  </span>
                </div>

                {/* title -> accredited */}
                <div class="col-sm-3 offset-sm-1">
                  <span class="fw-600 text-dark-gray fs-22 ls-minus-05px">
                    <a href={item.file} target="_blank">
                      {item.accredited}
                      <i class="fa-solid fa-arrow-up-right-from-square inline-block ms-3" />
                    </a>
                  </span>
                </div>

                {/* content -> board + date */}
                <div class="col-sm-7 p-35px sm-p-25px xs-p-20px xs-pt-10px last-paragraph-no-margin">
                  <p class="w-95 sm-w-100">
                    {item.accreditationBoard} <br />
                    {item.start} – {item.end}
                  </p>
                </div>
              </div>
            ))
          }

          {/* closing separator */}
          <div class="row g-0">
            <div class="col-12">
              <div
                class="separator-line-5px w-100 bg-medium-gray opacity-3 bg-sliding-line"
              >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-solitude-blue">
    <div class="container">
      <div class="row justify-content-center">
        <div
          class="col-xl-5 col-lg-6 md-mb-50px sm-mb-20px"
          data-anime='{ "el": "childs", "translateY": [50, 0], "opacity": [0,1], "duration": 600, "delay": 0, "staggervalue": 300, "easing": "easeOutQuad" }'
        >
          <h3
            class="text-dark-gray fw-600 ls-minus-1px mb-20px sm-w-85 xs-w-100"
          >
            Vision & Mission
          </h3>
          <p>
            Becoming a superior vocational study program in developing the field
            of corporate management that is adaptive and environmentally
            friendly and agro-industry at the international level
          </p>
          <div class="row row-cols-1 mt-40px">
            <!-- start process step item -->
            {
              t.missions.map((v, i) => (
                <ListProcess
                  number={i + 1}
                  isLast={i === t.missions.length - 1}
                  title={v.title}
                  content={v.body}
                />
              ))
            }
            <!-- end process step item -->
          </div>
        </div>
        <div
          class="col-xl-6 col-lg-6 offset-xl-1 position-relative md-mb-50px position-sticky top-120px"
          style="height: fit-content;"
        >
          <div
            class="text-end w-80 md-w-75 ms-auto"
            data-animation-delay="500"
            data-shadow-animation="true"
            data-bottom-top="transform: translateY(50px)"
            data-top-bottom="transform: translateY(-50px)"
          >
            <img
              src="https://psd3mp.feb.unej.ac.id/assets/theme/img/preview.webp"
              alt=""
              class="border-radius-5px"
            />
          </div>
          <div
            class="w-60 md-w-50 xs-w-55 overflow-hidden position-absolute left-15px bottom-minus-50px"
            data-shadow-animation="true"
            data-animation-delay="500"
            data-bottom-top="transform: translateY(-50px)"
            data-top-bottom="transform: translateY(50px)"
          >
            <img
              src="https://psd3mp.feb.unej.ac.id/assets/theme/img/preview.webp"
              alt=""
              class="border-radius-5px box-shadow-quadruple-large"
            />
          </div>
        </div>
      </div>
    </div>
    <div class="my-5">&nbsp;</div>
    <div class="container mt-5">
      <div class="d-flex justify-content-center">
        <div style="max-width: 998px;">
          <h4
            class="text-dark-gray fw-700 ls-minus-1px alt-font mb-40px lg-mb-30px d-block text-center"
          >
            {t.prodi_objective}
          </h4>
          <div
            class="border border-color-extra-medium-gray border-radius-6px mb-40px xs-mb-30px overflow-hidden"
          >
            {
              t.objectives.map((item, index) => (
                <p class="ps-30px pe-30px pt-25px pb-25px border-bottom border-1 border-color-extra-medium-gray mb-0">
                  {item}
                </p>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
  <PageSection title={t.information}>
    <PillDivider
      icon="fa-regular fa-newspaper"
      text={t.academicRequirements}
      class="mb-3"
    />
    <ContentRenderer showContent={false} class="my-3 py-5" />
    <PillDivider
      icon="fa-regular fa-newspaper"
      text={t.graduateProfile}
      class="mb-3"
    />
    <ContentRenderer showContent={false} class="my-3 py-5" />
    <PillDivider
      icon="fa-regular fa-newspaper"
      text={t.curriculum}
      class="mb-3"
    />
    <ContentRenderer showContent={false} class="my-3 py-5" />
  </PageSection>
  <PageSection
    title={t.important_information_access}
    class="overflow-hidden bg-very-light-gray position-relative"
  >
    <div
      class="row align-items-center"
      data-anime='{ "opacity": [0,1], "duration": 600, "delay":0, "staggervalue": 300, "easing": "easeOutQuad" }'
    >
      <div class="col-12">
        <div class="outside-box-right-20 sm-outside-box-right-0">
          <div
            class="swiper magic-cursor drag-cursor slider-one-slide"
            data-slider-options='{ "slidesPerView": 1, "spaceBetween": 30, "loop": true, "navigation": { "nextEl": ".slider-one-slide-next-1", "prevEl": ".slider-one-slide-prev-1" }, "autoplay": { "delay": 4000, "disableOnInteraction": false }, "keyboard": { "enabled": true, "onlyInViewport": true }, "breakpoints": { "1200": { "slidesPerView": 4 }, "992": { "slidesPerView": 3 }, "768": { "slidesPerView": 2 }, "320": { "slidesPerView": 1 } }, "effect": "slide" }'
          >
            <div class="swiper-wrapper">
              {
                Array.from({ length: 8 }).map((_, i) => (
                  <div class="swiper-slide">
                    <div class="services-box-style-03 last-paragraph-no-margin border-radius-6px overflow-hidden">
                      <div class="bg-white">
                        <div class="ps-65px pe-65px pt-30px pb-30px text-center">
                          <a
                            href="#"
                            class="d-inline-block fs-18 fw-600 text-dark-gray mb-5px"
                          >
                            Service title {i + 1}
                          </a>
                          <p>
                            Lorem ipsum simply dummy text of amet consectetur.
                          </p>
                        </div>

                        <div class="d-flex justify-content-center border-top border-color-extra-medium-gray pt-20px pb-20px ps-50px pe-50px position-relative text-center">
                          <a
                            href="#"
                            class="btn btn-link btn-hover-animation-switch btn-medium fw-700 text-dark-gray text-uppercase"
                          >
                            <span>
                              <span class="btn-text">Explore services</span>
                              <span class="btn-icon">
                                <i class="fa-solid fa-arrow-right" />
                              </span>
                              <span class="btn-icon">
                                <i class="fa-solid fa-arrow-right" />
                              </span>
                            </span>
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- <p>Haloo</p> -->
  </PageSection>
  <ProdiNewsPreview prodi="accounting" />
</Layout>
