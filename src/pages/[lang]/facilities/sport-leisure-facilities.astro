---
import BlogCard from "@/components/widgets/card/blogCard.astro";
import CardContainer from "@/components/widgets/card/cardContainer.astro";
import PageSection from "@/components/widgets/pageSection.astro";
import PageTitleTypography from "@components/widgets/pageTitleTypography.astro";
import { getLocale, useI18n } from "@i18n/i18n";
import Layout from "@layouts/main.astro";

const messages = {
  en: {
    pageTitle: "Facility Sport and Leisure",
    title: "Facility Sport and Leisure",
    intro:
      "Facility sport and leisure refers to the range of facilities and activities that universities offer to promote physical activity, health, and wellness among their students, faculty, and staff. These facilities and activities may include sports facilities, food court, and outdoor recreational spaces.",
    intro2:
      "Sports facilities: Universities may provide students with access to sports facilities, such as basketball courts, soccer fields, tennis courts, rock climbing, and indoor sports halls. These facilities may be available for both recreational use and organized team sports.",
    intro3:
      "Outdoor recreation space: Universities may offer outdoor recreation spaces, such as parks, jogging trails, and bicycle paths, for students, faculty, and staff to enjoy.",
    intro4:
      "Sports and recreation programs: Universities may also offer organized sports and recreation programs, such as intramural sports leagues, group fitness classes, and wellness programs. These programs are designed to encourage physical activity and promote health and well-being within the university community.",
    intro5:
      "A food court is a common area within a university where multiple food vendors are located in one centralized location. It is designed to provide students, faculty, and staff with convenient and diverse dining options.",
  },
  id: {
    pageTitle: "Fasilitas Olahraga dan Rekreasi",
    title: "Fasilitas Olahraga dan Rekreasi",
    intro:
      "Fasilitas olahraga dan rekreasi mengacu pada berbagai fasilitas dan aktivitas yang ditawarkan universitas untuk mempromosikan aktivitas fisik, kesehatan, dan kesejahteraan di antara mahasiswa, fakultas, dan staf mereka. Fasilitas dan aktivitas ini dapat mencakup fasilitas olahraga, food court, dan ruang rekreasi luar ruangan.",
    intro2:
      "Fasilitas olahraga: Universitas dapat menyediakan akses kepada mahasiswa ke fasilitas olahraga, seperti lapangan basket, lapangan sepak bola, lapangan tenis, panjat tebing, dan aula olahraga dalam ruangan. Fasilitas ini dapat digunakan untuk rekreasi maupun olahraga tim yang terorganisir.",
    intro3:
      "Ruang rekreasi luar ruangan: Universitas dapat menyediakan ruang rekreasi luar ruangan, seperti taman, jalur jogging, dan jalan sepeda, untuk mahasiswa, fakultas, dan staf untuk menikmati.",
    intro4:
      "Program olahraga dan rekreasi: Universitas juga dapat menawarkan program olahraga dan rekreasi yang terorganisir, seperti liga olahraga intramural, kelas kebugaran kelompok, dan program kesehatan. Program-program ini dirancang untuk mendorong aktivitas fisik serta meningkatkan kesehatan dan kesejahteraan di lingkungan universitas.",
    intro5:
      "Food court adalah area umum di dalam universitas tempat berbagai penjual makanan berada dalam satu lokasi terpusat. Area ini dirancang untuk menyediakan pilihan makanan yang praktis dan beragam bagi mahasiswa, dosen, dan staf.",
  },
};
const t = useI18n(messages, getLocale(Astro));
---

<Layout title={t.pageTitle}>
  <PageTitleTypography title={t.pageTitle} image="/_astro/images/bg-feb.webp" />
  <PageSection title={t.title} class="pt-0">
    <div>
      <p class="text-dark-gray fw-700 mb-40px">
        {t.intro}
      </p>
      <p class="text-dark-gray fw-700 mb-40px">
        {t.intro2}
      </p>
    </div>

    <CardContainer type="blog-standard">
      {
        Array.from({ length: 3 }).map((_, i) => (
          <BlogCard
            image=""
            title="Lorem ipsum dolor sit amet."
            description="Lorem ipsum dolor sit amet consectetur adipisicing elit. Reiciendis maxime magni praesentium dolores, debitis incidunt quibusdam impedit perferendis sapiente quo reprehenderit accusantium repellendus quasi sequi ab nemo? Reprehenderit, repudiandae quas!"
            href="javascript:void(0)"
          />
        ))
      }
    </CardContainer>

    <div>
      <p class="text-dark-gray fw-700 mb-40px">
        {t.intro3}
      </p>
    </div>

    <CardContainer type="blog-standard">
      {
        Array.from({ length: 3 }).map((_, i) => (
          <BlogCard
            image=""
            title="Lorem ipsum dolor sit amet."
            description="Lorem ipsum dolor sit amet consectetur adipisicing elit. Reiciendis maxime magni praesentium dolores, debitis incidunt quibusdam impedit perferendis sapiente quo reprehenderit accusantium repellendus quasi sequi ab nemo? Reprehenderit, repudiandae quas!"
            href="javascript:void(0)"
          />
        ))
      }
    </CardContainer>

    <div class="md-mb-15 sm-mb-20 text-center text-lg-start">
      <p class="text-dark-gray fw-700 mb-40px">
        {t.intro4}
      </p>
      <p class="text-dark-gray fw-700 mb-40px">
        {t.intro5}
      </p>
    </div>

    <CardContainer type="blog-standard">
      {
        Array.from({ length: 3 }).map((_, i) => (
          <BlogCard
            image=""
            title="Lorem ipsum dolor sit amet."
            description="Lorem ipsum dolor sit amet consectetur adipisicing elit. Reiciendis maxime magni praesentium dolores, debitis incidunt quibusdam impedit perferendis sapiente quo reprehenderit accusantium repellendus quasi sequi ab nemo? Reprehenderit, repudiandae quas!"
            href="javascript:void(0)"
          />
        ))
      }
    </CardContainer>
  </PageSection>
</Layout>
