---
import ListNum from "@/components/widgets/list/ListNum.astro";
import { getLocale, useI18n } from "@/i18n/i18n";
import PageTitleTypography from "@components/widgets/pageTitleTypography.astro";
import Layout from "@layouts/main.astro";
import type { ColumnDefinition } from "tabulator-tables";

export const messages = {
  en: {
    existing_condition: {
      title: "Existing Condition",
      introduction:
        "The internationalization of higher education is defined as a process in which universities integrate international components into their goals, functions, or delivery of education. This section outlines the current condition analysis, covering all activities and programs that have been implemented to support internationalization at the Faculty of Economics and Business (FEB), University of Jember. These activities and programs include:",
      items: [
        {
          title: "FIBAA International Accreditation",
          content:
            "Out of all study programs at FEB University of Jember, three programs—Bachelor of Management, Bachelor of Accounting, and Bachelor of Development Economics—successfully achieved FIBAA accreditation in September 2023.",
        },
        {
          title: "Bilingual Class",
          content:
            "Further information regarding the Bilingual Class can be accessed on this Admissions page <a class='text-primary alt-font mb-5px' href='/en/admissions/recruitment'>Bilingual Class</a>.",
        },
        {
          title: "Strengthening International Cooperation",
          content:
            "In 2022, there were 21 active cooperation agreements at the University of Jember, several of which were initiated by FEB. These include partnerships with San Carlos University, Universiti Sultan Zainal Abidin Malaysia, and Universiti College Bestari. FEB University of Jember is also in the process of initiating MoUs with Universiti Kebangsaan Malaysia and the Indian Institute of Technology.",
        },
        {
          title: "Lecturer Exchange",
          content:
            "To support the internationalization of FEB University of Jember and enhance lecturer competencies, lecturer exchange programs have been implemented since 2017. These exchanges involve foreign universities that already have MoUs with the University of Jember, as well as universities currently in the process of initiating MoUs. The program is strengthened by the qualifications of FEB lecturers—55 out of 113 (59%) hold doctoral degrees, many of whom graduated from reputable universities in Indonesia and abroad.",
        },
        {
          title: "Student Mobility (Inbound & Outbound)",
          content:
            "FEB UNEJ consistently opens opportunities for international students to study either full-time or part-time. International student enrollment can be processed through the UNEJ International Office. FEB also encourages active students to gain overseas learning experiences through various exchange schemes such as the Indonesian International Student Mobility Awards (IISMA) and the International Credit Transfer Program (ICTP). Additionally, students can participate in exchange programs managed by the International Office in collaboration with foreign institutions.",
        },
        {
          title: "Joint Research & Publication",
          content:
            "Internationalization in FEB UNEJ is also supported through joint research and joint publication activities. In 2021, three collaborative research projects were conducted with lecturers from Universiti Sultan Zainal Abidin, Malaysia and published in CPC-indexed international proceedings.",
        },
        {
          title: "International Conference",
          content:
            "From 2021 to 2023, FEB UNEJ has actively participated in organizing international conferences either as the main organizer or as a co-host.",
        },
      ],
    },
  },
  id: {
    existing_condition: {
      title: "Kondisi Saat Ini",
      introduction:
        "Internasionalisasi perguruan tinggi didefinisikan sebagai proses di perguruan tinggi yang mengintegrasikan komponen internasional ke dalam tujuan, fungsi, atau penyampaian pendidikan. Pada bagian ini akan digambarkan mengenai analisis kondisi saat ini yang meliputi seluruh kegiatan dan program-program yang telah diimplementasikan untuk mendukung internasionalisasi di Fakultas Ekonomi dan Bisnis (FEB) Universitas Jember. Kegiatan dan program tersebut antara lain:",
      items: [
        {
          title: "Akreditasi Internasional FIBAA",
          content:
            "Dari seluruh program studi di FEB Universitas Jember, 3 program studi yang telah terakreditasi FIBAA pada bulan September 2023, yaitu S1 Manajemen, S1 Akuntansi dan S1 Ekonomi Pembangunan.",
        },
        {
          title: "Kelas Bilingual",
          content:
            "Informasi lebih lanjut mengenai Kelas Bilingual dapat diakses pada halaman ini Admisi <a class='text-primary alt-font mb-5px' href='/id/admissions/recruitment'>Kelas Bilingual</a>.",
        },
        {
          title: "Peningkatan Kerjasama Luar Negeri",
          content:
            "Pada tahun 2022 terdapat 21 perjanjian kerjasama yang aktif pada Universitas Jember dimana sebagian MoU tersebut merupakan hasil inisiasi dari FEB.",
        },
        {
          title: "Lecturer Exchange",
          content:
            "Sejak tahun 2017 telah diimplementasikan kegiatan pertukaran dosen dengan universitas luar negeri baik yang telah maupun yang sedang dalam tahap inisiasi MoU.",
        },
        {
          title: "Students Mobility (Inbound & Outbound)",
          content:
            "FEB UNEJ membuka peluang bagi mahasiswa asing serta mendorong mahasiswa aktif mengikuti program mobilitas internasional seperti IISMA dan ICTP.",
        },
        {
          title: "Joint Research & Publication",
          content:
            "FEB UNEJ telah melakukan joint research dengan universitas luar negeri meskipun jumlahnya masih terbatas.",
        },
        {
          title: "International Conference",
          content:
            "FEB UNEJ aktif dalam penyelenggaraan International Conference periode 2021–2023.",
        },
      ],
    },
  },
};

const locale = getLocale(Astro);

const tableDict = {
  en: {
    number: "#",
    study_program: "STUDY PROGRAM",
    accredited: "ACCREDITED",
    start: "START",
    until: "UNTIL",
    by: "By",

    year_of_cooperation: "Year of Cooperation",
    total_per_2022: "Total (per September 2022)",
    new: "New",
    accumulated: "Accumulated",
    end: "End",
    active: "Active",
    yes: "Yes",
    no: "No",
  },
  id: {
    number: "NO",
    study_program: "PROGRAM STUDI",
    accredited: "TERAKREDITASI",
    start: "MULAI",
    until: "SAMPAI",
    by: "Oleh",

    year_of_cooperation: "Tahun Kerjasama",
    total_per_2022: "Jumlah (per September 2022)",
    new: "Baru",
    accumulated: "Akumulasi",
    end: "Berakhir",
    active: "Aktif",
    yes: "Ya",
    no: "Tidak",
  },
}[locale];

const t = useI18n(messages, getLocale(Astro));

interface Table {
  columns: ColumnDefinition[];
  rows: Record<string, unknown>[];
}

const tableInternationalAccreditation: Table = {
  columns: [
    {
      title: "",
      formatter: "responsiveCollapse",
      headerSort: false,
    },
    {
      title: tableDict.number,
      formatter: "rownum",
      headerSort: false,
      frozen: true,
      hozAlign: "center",
    },
    {
      title: tableDict.study_program,
      field: "study_program",
      formatter: function (cell, formatterParams) {
        const div = document.createElement("div");
        div.style.whiteSpace = "normal";
        const value = cell.getValue();
        div.textContent = value;
        return div;
      },
      variableHeight: true,
      // minWidth: 100,
      maxWidth: 400,
    },
    {
      title: tableDict.accredited,
      field: "accredited",
      formatter: function (cell, formatterParams) {
        const div = document.createElement("div");
        div.style.whiteSpace = "normal";
        const value = cell.getValue();
        div.textContent = value;
        return div;
      },
      variableHeight: true,
      // minWidth: 100,
      maxWidth: 400,
      widthGrow: 1,
    },
    {
      title: tableDict.start,
      field: "start",
    },
    {
      title: tableDict.until,
      field: "until",
    },
    {
      title: tableDict.by,
      field: "by",
    },
  ],
  rows: [
    {
      study_program: "Doctor of Management",
      accredited: "Very Good",
      start: "05 January 2024",
      until: "21 November 2028",
      by: "LAMEMBA",
    },
    {
      study_program: "Bachelor of Management",
      accredited: "Excellence",
      start: "20 September 2023",
      until: "20 September 2028",
      by: "FIBAA",
    },
    {
      study_program: "Bachelor of Development Economics",
      accredited: "Excellence",
      start: "20 September 2023",
      until: "19 September 2028",
      by: "FIBAA",
    },
  ],
};

const tableStrengtheningInternationalCooperation: Table = {
  columns: [
    {
      title: "",
      formatter: "responsiveCollapse",
      headerSort: false,
    },
    {
      title: tableDict.number,
      formatter: "rownum",
      headerSort: false,
      frozen: true,
      hozAlign: "center",
    },
    {
      title: tableDict.year_of_cooperation,
      field: "year_of_cooperation",
    },
    {
      title: tableDict.total_per_2022,
      field: "total_per_2022",
      widthGrow: 1,
      columns: [
        {
          title: tableDict.new,
          field: "new",
        },
        {
          title: tableDict.accumulated,
          field: "accumulated",
        },
        {
          title: tableDict.end,
          field: "end",
        },
        {
          title: tableDict.active,
          field: "active",
        },
      ],
    },
  ],
  rows: [
    {
      year_of_cooperation: 2018,
      new: 4,
      accumulated: 9,
      end: 0,
      active: 4,
    },
    {
      year_of_cooperation: 2019,
      new: 2,
      accumulated: 11,
      end: 1,
      active: 5,
    },
    {
      year_of_cooperation: 2020,
      new: 2,
      accumulated: 13,
      end: 0,
      active: 7,
    },
    {
      year_of_cooperation: 2021,
      new: 6,
      accumulated: 19,
      end: 0,
      active: 13,
    },
    {
      year_of_cooperation: 2022,
      new: 8,
      accumulated: 27,
      end: 0,
      active: 21,
    },
  ].map((v) => ({
    ...v,
    end: v.end == 0 ? tableDict.no : tableDict.yes,
  })),
};
---

<Layout title={t.existing_condition.title}>
  <PageTitleTypography
    title={t.existing_condition.title}
    image="/_astro/images/bg-feb.webp"
  />
  <section>
    <div class="container">
      <span class="badge">
        {t.existing_condition.title}
      </span>

      <p class="fw-700">
        {t.existing_condition.introduction}
      </p>

      <div class="row">
        <ListNum number={1} title={t.existing_condition.items[0].title}>
          <div slot="content" class="container ps-0">
            <p>{t.existing_condition.items[0].content}</p>
            <div
              class="pe-4"
              id="table-1"
              data-columns={JSON.stringify(
                tableInternationalAccreditation.columns,
              )}
              data-rows={JSON.stringify(tableInternationalAccreditation.rows)}
            >
            </div>
          </div>
        </ListNum>
        <ListNum
          number={2}
          title={t.existing_condition.items[1].title}
          class="pt-2"
        >
          <div slot="content" class="container ps-0">
            <p set:html={t.existing_condition.items[1].content} />
            <div>
              <img src="" style="width: 100%;" is="auto-bg-color" alt="" />
            </div>
          </div>
        </ListNum>
        <ListNum
          number={3}
          title={t.existing_condition.items[2].title}
          class="pt-2"
        >
          <div slot="content" class="container ps-0">
            <p set:html={t.existing_condition.items[2].content} />
            <div
              class="pe-4"
              id="table-2"
              data-columns={JSON.stringify(
                tableStrengtheningInternationalCooperation.columns,
              )}
              data-rows={JSON.stringify(
                tableStrengtheningInternationalCooperation.rows,
              )}
            >
            </div>
            <div class="pt-2">
              <img src="" style="width: 100%;" is="auto-bg-color" alt="" />
            </div>
          </div>
        </ListNum>
        <ListNum
          number={4}
          title={t.existing_condition.items[3].title}
          class="pt-2"
        >
          <div slot="content" class="container ps-0">
            <p set:html={t.existing_condition.items[3].content} />
          </div>
        </ListNum>
        <ListNum
          number={5}
          title={t.existing_condition.items[4].title}
          class="pt-2"
        >
          <div slot="content" class="container ps-0">
            <p set:html={t.existing_condition.items[4].content} />
          </div>
        </ListNum>
        <ListNum
          number={6}
          title={t.existing_condition.items[5].title}
          class="pt-2"
        >
          <div slot="content" class="container ps-0">
            <p set:html={t.existing_condition.items[5].content} />
          </div>
        </ListNum>
        <ListNum
          number={7}
          title={t.existing_condition.items[6].title}
          class="pt-2"
        >
          <div slot="content" class="container ps-0">
            <p set:html={t.existing_condition.items[6].content} />
          </div>
        </ListNum>
      </div>
    </div>
  </section>

  <script>
    import "@components/customComponents/imgAutoBGColor";
    import { TabulatorFull as Tabulator } from "tabulator-tables";
    import "tabulator-tables/dist/css/tabulator_materialize.min.css";
    function initTable(id: string) {
      const tableEl: HTMLElement | null = document.getElementById(id);

      const tableElDt = tableEl?.dataset;
      if (tableElDt) {
        const dtColumns = tableElDt.columns;
        const dtRows = tableElDt.rows;
        if (dtColumns && dtRows) {
          const columns = JSON.parse(dtColumns);
          const rows = JSON.parse(dtRows);
          if (tableEl) {
            new Tabulator(tableEl, {
              data: rows, //link data to table
              reactiveData: true, //enable data reactivity
              columns, //define table columns
              layout: "fitDataFill",
              maxHeight: window.innerHeight - 200,
              responsiveLayout: "collapse",
              responsiveLayoutCollapseStartOpen: false,
            });
          }
        }
      }
    }
    initTable("table-1");
    initTable("table-2");
  </script>
</Layout>
