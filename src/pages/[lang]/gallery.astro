---
import ModulesGalleryCard from "@/components/modules/gallery/card.astro";
import ContentContainer from "@/components/widgets/contentContainer.astro";
import WidgetsHeroSlider from "@/components/widgets/pageTitleTypography.astro";
import { galleryService } from "@/services/gallery.service";
import { getLocale } from "@i18n/i18n";
import Layout from "@layouts/main.astro";

// locale (contoh: dari URL / middleware)
const locale = getLocale(Astro);
// i18n lokal
const messages = {
  en: {
    pageTitle: "Galleries",
    title: "Galleries",
  },
  id: {
    pageTitle: "Galeri",
    title: "Galeri",
  },
};

const t = (key: keyof (typeof messages)[keyof typeof messages]) =>
  messages[locale][key];

const gsGetGalleries = await galleryService.getPhotoGallery();
const galleries = gsGetGalleries?.data || [];
---

<Layout title={t("title")}>
  <WidgetsHeroSlider
    title={t("pageTitle")}
    image="/_astro/images/bg-feb.webp"
  />

  <section class="pb-0 ipad-top-space-margin md-pt-0">
    <div class="container">
      <div class="row justify-content-center mb-3">
        <div
          class="col-lg-7 text-center"
          data-anime='{ "el": "childs", "translateY": [30, 0], "opacity": [0,1], "duration": 600, "delay": 0, "staggervalue": 300, "easing": "easeOutQuad" }'
        >
          <h3 class="text-dark-gray fw-700 ls-minus-1px">
            {t("title")}
          </h3>
        </div>
      </div>
    </div>
  </section>

  <section class="pt-0">
    <div class="container">
      <div class="row">
        {
          !!galleries?.length && (
            <div class="col-12 filter-content">
              <ul class="portfolio-boxed portfolio-wrapper grid-loading grid grid-3col xxl-grid-3col xl-grid-3col lg-grid-3col md-grid-2col sm-grid-2col xs-grid-1col gutter-large text-center">
                <li class="grid-sizer" />

                {galleries.map((gallery) => (
                  <li class="grid-item selected digital transition-inner-all gallery-box">
                    <ModulesGalleryCard
                      image={gallery.file}
                      title={gallery.judul}
                    />
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        {!galleries?.length && <ContentContainer />}
      </div>
    </div>
  </section>
</Layout>
