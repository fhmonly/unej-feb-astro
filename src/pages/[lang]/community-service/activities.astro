---
import ListContainer from "@/components/widgets/list/ListContainer.astro";
import ListProcess from "@/components/widgets/list/ListProcess.astro";
import { getLocale, useI18n } from "@/i18n/i18n";
import { wordsJson } from "@/i18n/words";
import PageTitleTypography from "@components/widgets/pageTitleTypography.astro";
import Layout from "@layouts/main.astro";

const messages = {
  en: {
    community_service: {
      title: "Community Services Activities",
      intro:
        "Community service by lecturers in the Faculty of Economics and Business has significant benefits for the community, students, and the lecturers themselves. Some of the benefits of community service by lecturers in the Faculty of Economics and Business are as follows:",
      benefits: {
        research:
          "Improving the quality and quantity of research. Lecturers who are involved in community service in the Faculty of Economics and Business will directly interact with the community and industry. This can help lecturers understand the real needs and challenges faced by the community and industry. This knowledge can help lecturers develop relevant and beneficial research for the community and industry.",
        education_quality:
          "Improving the quality of education. Lecturers who are involved in community service in the Faculty of Economics and Business can also help students develop skills and knowledge in the field of economics and business. Lecturers can guide students to carry out community service projects that provide benefits to the community.",
        relationship_strength:
          "Strengthening relationships with the community and industry. Lecturers who are involved in community service in the Faculty of Economics and Business can help strengthen the relationship between the university and the community and industry. This can help the faculty in building a wide network of cooperation with various parties.",
        real_world_relevance:
          "Improving the relevance of education with the real world. Community service by lecturers in the Faculty of Economics and Business can help ensure that the education provided at the faculty is relevant to the real world. Lecturers can use the experience and knowledge gained from community service to develop a relevant and up-to-date curriculum.",
        community_welfare:
          "Improving community welfare. Lecturers who are involved in community service in the Faculty of Economics and Business can help the community overcome economic and business problems. Lecturers can help the community design solutions and implement them to improve community welfare.",
      },
      closing:
        "Thus, community service by lecturers in the Faculty of Economics and Business provides significant benefits to the community, students, and lecturers themselves. Through community service, the faculty can help the community and industry in overcoming economic and business problems and improving the relevance of education to the real world.",
    },
  },
  id: {
    community_service: {
      title: "Kegiatan Pengabdian kepada Masyarakat",
      intro:
        "Kegiatan pengabdian masyarakat oleh dosen di Fakultas Ekonomi dan Bisnis memiliki manfaat yang signifikan bagi masyarakat, mahasiswa, dan para dosen itu sendiri. Beberapa manfaat pengabdian masyarakat oleh dosen di Fakultas Ekonomi dan Bisnis adalah sebagai berikut:",
      benefits: {
        research:
          "Meningkatkan kualitas dan kuantitas penelitian. Dosen yang terlibat dalam pengabdian masyarakat di Fakultas Ekonomi dan Bisnis akan berinteraksi langsung dengan masyarakat dan industri. Hal ini dapat membantu dosen memahami kebutuhan dan tantangan nyata yang dihadapi oleh masyarakat dan industri. Pengetahuan ini dapat membantu dosen mengembangkan penelitian yang relevan dan bermanfaat bagi masyarakat dan industri.",
        education_quality:
          "Meningkatkan kualitas pendidikan. Dosen yang terlibat dalam pengabdian masyarakat di Fakultas Ekonomi dan Bisnis juga dapat membantu mahasiswa mengembangkan keterampilan dan pengetahuan di bidang ekonomi dan bisnis. Dosen dapat membimbing mahasiswa untuk melaksanakan proyek pengabdian masyarakat yang memberikan manfaat bagi masyarakat.",
        relationship_strength:
          "Memperkuat hubungan dengan masyarakat dan industri. Dosen yang terlibat dalam pengabdian masyarakat di Fakultas Ekonomi dan Bisnis dapat membantu memperkuat hubungan antara universitas dengan masyarakat dan industri. Hal ini dapat membantu fakultas dalam membangun jaringan kerja sama yang luas dengan berbagai pihak.",
        real_world_relevance:
          "Meningkatkan relevansi pendidikan dengan dunia nyata. Pengabdian masyarakat oleh dosen di Fakultas Ekonomi dan Bisnis dapat membantu memastikan bahwa pendidikan yang diberikan di fakultas tersebut relevan dengan dunia nyata. Dosen dapat menggunakan pengalaman dan pengetahuan yang diperoleh dari pengabdian masyarakat untuk mengembangkan kurikulum yang relevan dan mutakhir.",
        community_welfare:
          "Meningkatkan kesejahteraan masyarakat. Dosen yang terlibat dalam pengabdian masyarakat di Fakultas Ekonomi dan Bisnis dapat membantu masyarakat mengatasi masalah ekonomi dan bisnis. Dosen dapat membantu masyarakat merancang solusi dan menerapkannya untuk meningkatkan kesejahteraan masyarakat.",
      },
      closing:
        "Dengan demikian, pengabdian masyarakat oleh para dosen di Fakultas Ekonomi dan Bisnis memberikan manfaat yang signifikan bagi masyarakat, mahasiswa, dan para dosen itu sendiri. Melalui pengabdian masyarakat, fakultas dapat membantu masyarakat dan industri dalam mengatasi masalah ekonomi dan bisnis serta meningkatkan relevansi pendidikan dengan dunia nyata.",
    },
  },
};
const benefits = [
  "research",
  "education_quality",
  "relationship_strength",
  "real_world_relevance",
  "community_welfare",
] as const;

const videos = Array.from({ length: 7 }, (_, i) => i + 1);
const t = useI18n(messages, getLocale(Astro)).community_service;
const tWords = useI18n(wordsJson, getLocale(Astro));
---

<Layout title={t.title}>
  <PageTitleTypography title={t.title} image="/_astro/images/bg-feb.webp" />
  <section>
    <div class="container position-relative">
      <div class="row align-items-center">
        <div class="md-mb-15 sm-mb-20 text-center text-lg-start">
          <span
            class="ps-25px pe-25px mb-20px text-uppercase text-base-color fs-14 lh-42px fw-700 border-radius-100px bg-gradient-very-light-gray-transparent d-inline-block"
          >
            {t.title}
          </span>

          <p class="text-dark-gray fw-700 mb-40px">
            {t.intro}
          </p>

          <ListContainer class="row-cols-1">
            {
              benefits.map((value, index) => (
                <ListProcess
                  number={index + 1}
                  isLast={index === benefits.length - 1}
                >
                  <p class="w-90 lg-w-100 lh-32" slot="title">
                    {t.benefits[value]}
                  </p>
                </ListProcess>
              ))
            }
          </ListContainer>

          <p class="text-dark-gray fw-700 mb-40px">
            {t.closing}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- video section -->
  <section class="bg-very-light-gray py-5">
    <div class="container">
      <div class="row g-4">
        {
          videos.map((value) => (
            <div class="col-12 col-md-6 col-lg-4">
              <div class="bg-white p-40px sm-p-30px h-100 box-shadow-small d-flex flex-column">
                <div class="flex-grow-1">
                  <h5 class="mb-3">Video Title {value}</h5>
                  <p class="text-muted mb-0">
                    Deskripsi singkat tentang video ini. Jelaskan konten yang
                    akan ditonton.
                  </p>
                </div>

                <div class="d-flex justify-content-center align-items-center mt-4">
                  <a
                    href="https://www.youtube.com/watch?v=cfXHhfNy7tU"
                    class="popup-youtube d-inline-flex align-items-center gap-2 text-decoration-none"
                  >
                    <i class="bi bi-play-circle fs-4" />
                    <span>{tWords.play} Video</span>
                  </a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
