---
import { getLocale, useI18n } from "@/i18n/i18n";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  placeholder?: string;
}

const { placeholder, ...attrs } = Astro.props;

const dict = {
  id: {
    contentNotAvailableYet: "Konten belum tersedia saat ini",
  },
  en: {
    contentNotAvailableYet: "Content is not available yet",
  },
};

const locale = getLocale(Astro);
const t = useI18n(dict, locale);
---

<div class:list={`${attrs.class}`} {...attrs}>
  <slot>
    <div
      class="py-4 d-flex justify-content-center align-items-center"
      style="background-color: #f0f4fd;"
    >
      <slot name="fallback-text">
        <p class="text-center mb-0 text-secondary">
          {placeholder || t.contentNotAvailableYet}
        </p>
      </slot>
    </div>
  </slot>
</div>
