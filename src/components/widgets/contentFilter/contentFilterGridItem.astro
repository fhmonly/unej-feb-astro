---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"li"> {
  keywords?: string[];
}
const { class: className, keywords = [""], ...attrs } = Astro.props;
---

<li
  class:list={[
    "grid-item transition-inner-all",
    className,
    keywords.length > 0 ? keywords.join(" ") : "",
  ]}
  {...attrs}
>
  <slot />
</li>
