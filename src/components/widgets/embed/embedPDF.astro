---
const { url } = Astro.props;
const splitUrl: string[] = url.split("/");
const fileName = splitUrl[splitUrl.length - 1].replace(".pdf", "");
---

<div class="min-vh-100 bg-light py-4 py-md-5">
  <div class="container">
    <!-- PDF Container -->
    <div
      id="pdf-wrapper"
      class="bg-white rounded-4 shadow-lg overflow-hidden transition-all"
    >
      <!-- Toolbar -->
      <div
        class="bg-dark px-4 py-3 d-flex align-items-center justify-content-between"
      >
        <div class="d-flex align-items-center gap-2" style="width: 87%;">
          <div class="d-flex align-items-center justify-content-center gap-1">
            <div class="window-control bg-danger"></div>
            <div class="window-control bg-warning"></div>
            <div class="window-control bg-success"></div>
          </div>
          <div class="text-truncate ps-2 d-flex">
            <p class="text-white fw-medium small text-truncate m-0">
              {fileName}
            </p>
            <span class="text-white small">.pdf</span>
          </div>
        </div>

        <div class="d-flex align-items-center gap-2">
          <a
            href={url}
            download
            class="btn btn-sm btn-outline-light border-0 toolbar-btn"
            title="Download PDF"
          >
            <!-- download icon -->
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
          </a>

          <button
            id="fullscreen-btn"
            class="btn btn-sm btn-outline-light border-0 toolbar-btn"
            title="Fullscreen"
          >
            <!-- fullscreen icon -->
            <svg
              id="fs-enter"
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"
              ></path>
            </svg>

            <!-- exit fullscreen -->
            <svg
              id="fs-exit"
              class="d-none"
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"
              ></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- PDF Viewer -->
      <div id="pdf-container" class="bg-light pdf-container">
        <embed
          src={url}
          type="application/pdf"
          width="100%"
          height="100%"
          class="shadow-sm"
        />
      </div>
    </div>

    <div id="footer-info" class="mt-4 text-center">
      <p class="text-muted small mb-0">
        Tekan tombol fullscreen untuk pengalaman viewing yang lebih baik
      </p>
    </div>
  </div>
</div>

<script is:inline>
  const wrapper = document.getElementById("pdf-wrapper");
  const container = document.getElementById("pdf-container");
  const btn = document.getElementById("fullscreen-btn");
  const fsEnter = document.getElementById("fs-enter");
  const fsExit = document.getElementById("fs-exit");
  const footer = document.getElementById("footer-info");

  let isFullscreen = false;

  btn.addEventListener("click", () => {
    isFullscreen = !isFullscreen;

    wrapper.classList.toggle("position-fixed", isFullscreen);
    wrapper.classList.toggle("top-0", isFullscreen);
    wrapper.classList.toggle("start-0", isFullscreen);
    wrapper.classList.toggle("end-0", isFullscreen);
    wrapper.classList.toggle("bottom-0", isFullscreen);
    wrapper.classList.toggle("rounded-4", !isFullscreen);

    wrapper.style.zIndex = isFullscreen ? "1050" : "";
    container.style.height = isFullscreen ? "calc(100% - 60px)" : "800px";
    document.body.classList.toggle("pdf-fullscreen", isFullscreen);
    document.body.classList.toggle("overflow-hidden", isFullscreen);

    fsEnter.classList.toggle("d-none", isFullscreen);
    fsExit.classList.toggle("d-none", !isFullscreen);
    footer.classList.toggle("d-none", isFullscreen);
  });
</script>

<style>
  .window-control {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .toolbar-btn {
    padding: 0.375rem 0.5rem;
    transition: all 0.2s ease;
  }

  .toolbar-btn:hover {
    background-color: rgba(255, 255, 255, 0.1);
    transform: scale(1.05);
  }

  .pdf-container {
    height: 800px;
    position: relative;
  }

  .transition-all {
    transition: all 0.3s ease;
  }

  @media (max-width: 768px) {
    .pdf-container {
      height: 600px;
    }

    .position-fixed.m-3 {
      margin: 0.5rem !important;
    }
  }
</style>
