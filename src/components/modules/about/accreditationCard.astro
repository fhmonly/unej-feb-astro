---
import PopupImage from "@components/widgets/popupImage.astro";

interface Props {
  image: string;
  major: string;
  accBy: string;
  locale?: "id" | "en";
}

const { image, major, accBy, locale = "id" } = Astro.props;

const i18n = {
  en: {
    accreditedBy: "Accredited Excellent by",
  },
  id: {
    accreditedBy: "Terakreditasi Unggul oleh",
  },
};

const t = i18n[locale];
---

<div>
  <PopupImage image={image}>
    <div class="portfolio-image border-radius-4px">
      <img src={image} alt="" />

      <div class="portfolio-hover d-flex justify-content-center flex-column">
        <div
          class="portfolio-icon d-flex flex-row justify-content-center align-items-center"
        >
          <div
            class="d-flex flex-column justify-content-center text-dark-gray text-dark-gray-hover rounded-circle bg-white w-60px h-60px move-bottom-top"
          >
            <i class="bi bi-search icon-small" aria-hidden="true"></i>
          </div>
        </div>
      </div>

      <div
        class="portfolio-overlay bg-dark-gray"
        style="background-color:#637c8e"
      >
      </div>
    </div>

    <div class="portfolio-caption pt-20px pb-30px lg-pt-20px lg-pb-20px">
      <div class="fs-14 lh-20 text-uppercase">
        {t.accreditedBy}&nbsp;{accBy}
      </div>
      <div class="fs-17 fw-600 text-dark-gray text-dark-gray-hover">
        {major}
      </div>
    </div>
  </PopupImage>
</div>
