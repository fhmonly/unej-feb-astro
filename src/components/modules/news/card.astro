---
import ImageAutoBGColor from "@/components/base/img/imageAutoBGColor.astro";
import dayjs from "dayjs";

interface Props {
  newsType: string | null;
  title: string;
  date: string | null;
  image?: string | null;
  desc?: string;
  id?: string;
}

const { newsType, title, date, image, desc, id = "#" } = Astro.props;

const formattedDate = dayjs(date).format("DD MMMM YYYY");
---

<div class="card bg-transparent border-0 h-100">
  <div class="blog-image position-relative overflow-hidden border-radius-4px">
    <a href={`/news/${id}`}>
      <ImageAutoBGColor src={image} alt={title} loading="lazy" />
    </a>
  </div>

  <div
    class="card-body px-0 pt-30px pb-30px xs-pb-15px last-paragraph-no-margin"
  >
    <span class="fs-14 text-uppercase">
      <!-- optional category -->
      {
        newsType && (
          <a href="#" class="text-dark-gray fw-600 categories-text">
            {newsType}
          </a>
        )
      }
      <a href="#" class="blog-date">
        {!!date ? formattedDate : ""}
      </a>
    </span>

    <p style="margin-bottom:0!important">
      <a
        href={`/news/${id}`}
        class="card-title mb-15px fw-500 fs-18 lh-30 text-dark-gray d-inline-block"
      >
        {title}
      </a>
    </p>

    {desc && <p class="w-95 sm-w-100">{desc}</p>}
  </div>
</div>

<script></script>
