---
import ContentRenderer from "@/components/widgets/content/contentRenderer.astro";
import { wordsJson } from "@/i18n/words";
import { newsService } from "@/services/news.service";
import NewsCard from "@components/modules/news/card.astro";
import WidgetsPillDivider from "@components/widgets/heading/pillHeading.astro";
import { getLocale, getLocaleLink } from "@i18n/i18n";

const locale = getLocale(Astro);
const t = wordsJson[locale];

const pageDict = {
  en: {
    news: "News",
    content_not_available_yet: "News is not available yet",
  },
  id: {
    news: "Berita",
    content_not_available_yet: "Berita belum tersedia saat ini",
  },
}[locale];

const nsGetNews = await newsService.getNews({ page: 1 });
const news = nsGetNews?.data;
---

<section
  class="py-0 sm-pt-50px mb-3"
  style="margin-top: 90px"
  data-anime='{ "translateY": [0, 0], "opacity": [0,1], "duration": 1200, "delay": 0, "staggervalue": 150, "easing": "easeOutQuad" }'
>
  <div class="container">
    <WidgetsPillDivider text={t.news} />
    <div class="mb-5"></div>
    <div class="row mb-2">
      <ContentRenderer
        fallbackText={pageDict.content_not_available_yet}
        showContent={!!news?.results?.length}
      >
        <div class="col-12 px-0">
          <ul
            class="blog-classic blog-wrapper grid-loading grid grid-4col xl-grid-4col lg-grid-3col md-grid-2col sm-grid-2col xs-grid-1col gutter-double-extra-large"
            data-anime='{ "el": "childs", "translateY": [50, 0], "opacity": [0,1], "duration": 1200, "delay": 0, "staggervalue": 150, "easing": "easeOutQuad" }'
          >
            <li class="grid-sizer"></li>
            <!-- start blog item -->
            {
              news?.results.map((value) => (
                <li class="grid-item">
                  <NewsCard
                    date={value.tanggal}
                    title={value.judul}
                    newsType={value.kategori.nama}
                    image={value.gambar_unggulan}
                  />
                </li>
              ))
            }
            <!-- end blog item -->
          </ul>
        </div>
      </ContentRenderer>
    </div>
    <div
      class="row mb-7 sm-mb-9"
      data-anime='{ "el": "childs", "translateY": [0, 0], "opacity": [0,1], "duration": 1200, "delay": 0, "staggervalue": 150, "easing": "easeOutQuad" }'
    >
      <div class="col text-center">
        <a
          href={getLocaleLink(locale, "/news")}
          class="btn btn-large btn-dark-gray btn-hover-animation-switch btn-box-shadow btn-rounded me-25px xs-me-0"
        >
          <span>
            <span class="btn-text">{t.read_more}</span>
            <span class="btn-icon"
              ><i class="feather icon-feather-arrow-right"></i></span
            >
            <span class="btn-icon"
              ><i class="feather icon-feather-arrow-right"></i></span
            >
          </span>
        </a>
      </div>
    </div>
  </div>
</section>
