---
import { aboutProfilePageJson } from "@/i18n/pages/aboutProfile";
import { wordsJson } from "@/i18n/words";
import { getLocale, getLocaleLink } from "@i18n/i18n";

const locale = getLocale(Astro);
const tAbout = aboutProfilePageJson[locale].aboutPage;
const tWords = wordsJson[locale];

const steps = [1, 2, 3];
---

<section>
  <div class="container position-relative">
    <div class="row align-items-center mb-7">
      <div
        class="col-xxl-4 col-lg-5 md-mb-15 sm-mb-20 text-center text-lg-start"
      >
        <span
          class="ps-25px pe-25px mb-20px text-uppercase text-base-color fs-14 lh-42px fw-700 border-radius-100px bg-gradient-very-light-gray-transparent d-inline-block"
        >
          {tAbout.visionMission.title}
        </span>

        <p class="text-dark-gray fw-700 mb-40px">
          {tAbout.visionMission.vision}
        </p>

        <div
          class="row row-cols-1"
          data-anime='{ "el":"childs","translateY":[30,0],"opacity":[0,1],"duration":600,"delay":0,"staggervalue":300,"easing":"easeOutQuad" }'
        >
          {
            steps.map((value, index) => (
              <div class="col-12 process-step-style-05 position-relative hover-box">
                <div class="process-step-item d-flex">
                  <div class="process-step-icon-wrap position-relative">
                    <div class="process-step-icon d-flex justify-content-center align-items-center mx-auto rounded-circle h-60px w-60px fs-14 bg-light-red fw-700 position-relative">
                      <span class="number position-relative z-index-1 text-dark-gray">
                        0{value}
                      </span>
                      <div class="box-overlay bg-base-color rounded-circle" />
                    </div>
                    <span class="progress-step-separator bg-dark-gray opacity-1" />
                  </div>

                  <div class="process-content ps-30px last-paragraph-no-margin mb-30px">
                    <span class="d-block fw-700 text-dark-gray mb-5px fs-18">
                      {tAbout.visionMission.items[index].title}
                    </span>
                    <p class="w-90 lg-w-100 lh-32">
                      {tAbout.visionMission.items[index].description}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div
        class="col-lg-7 offset-xxl-1 position-relative md-mb-30px sm-mb-15"
        data-anime='{ "translateX":[0,0],"opacity":[0,1],"duration":1200,"delay":0,"staggervalue":150,"easing":"easeOutQuad" }'
      >
        <img
          src="/_astro/images/feb-front.jpg"
          class="position-relative z-index-9 top-40px"
          alt=""
        />
      </div>
    </div>

    <div class="row justify-content-center align-items-center">
      <div
        class="col-12 text-center align-items-center"
        data-anime='{ "translateY":[30,0],"opacity":[0,1],"duration":600,"delay":0,"staggervalue":300,"easing":"easeOutQuad" }'
      >
        <div class="fs-18 fw-500 text-dark-gray d-inline-block align-middle">
          {tWords.about_us},
          <a
            href={getLocaleLink(locale, "/about/profile")}
            class="text-dark-gray text-decoration-line-bottom fw-700"
          >
            {tWords.read_more}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
