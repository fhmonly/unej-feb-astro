---
import { getLocale } from "@i18n/i18n";

const i18n = {
  en: {
    contact: {
      badge: "Contact",
      title: "Contact Us",
      office: {
        title: "Office location",
        address:
          "Gg. 5, Tegal Boto Lor, Sumbersari, Kec. Sumbersari, Kabupaten Jember, East Java",
      },
      email: {
        title: "Send a message",
      },
      phone: {
        title: "Call us directly",
        main: "(0331) 337990",
        alt: "082337463327",
      },
    },
  },
  id: {
    contact: {
      badge: "Kontak",
      title: "Hubungi Kami",
      office: {
        title: "Lokasi Kantor",
        address:
          "Gg. 5, Tegal Boto Lor, Sumbersari, Kec. Sumbersari, Kabupaten Jember, Jawa Timur",
      },
      email: {
        title: "Kirim Pesan",
      },
      phone: {
        title: "Hubungi Langsung",
        main: "(0331) 337990",
        alt: "082337463327",
      },
    },
  },
};

const t = i18n[getLocale(Astro)].contact;
---

<section id="down-section">
  <div class="container">
    <div
      class="row align-items-end justify-content-center mb-6 text-center text-lg-start sm-mb-8"
    >
      <div class="col-xl-5 col-lg-7 col-md-10 md-mb-25px">
        <span
          class="ps-25px pe-25px mb-20px text-uppercase text-base-color fs-14 lh-42px fw-700 border-radius-100px bg-gradient-very-light-gray-transparent d-inline-block"
        >
          {t.badge}
        </span>

        <h3 class="text-dark-gray fw-700 ls-minus-1px mb-0">
          {t.title}
        </h3>
      </div>
    </div>

    <div
      class="row row-cols-1 row-cols-xl-4 row-cols-lg-4 row-cols-md-2 row-cols-sm-2 mb-6 sm-mb-8"
    >
      <!-- Office -->
      <div class="col md-mb-30px text-center text-sm-start">
        <span
          class="alt-font fs-18 fw-700 d-block w-90 text-dark-gray border-bottom border-2 border-color-dark-gray pb-15px mb-15px xs-w-100"
        >
          <i class="feather icon-feather-map-pin icon-small me-10px"></i>
          {t.office.title}
        </span>
        <p>{t.office.address}</p>
      </div>

      <!-- Email -->
      <div class="col md-mb-30px text-center text-sm-start">
        <span
          class="alt-font fs-18 fw-700 d-block w-90 text-dark-gray border-bottom border-2 border-color-dark-gray pb-15px mb-15px xs-w-100"
        >
          <i class="feather icon-feather-mail icon-small me-10px"></i>
          {t.email.title}
        </span>
        <a href="mailto:feb@unej.ac.id">feb@unej.ac.id</a>
      </div>

      <!-- Phone -->
      <div class="col xs-mb-30px text-center text-sm-start">
        <span
          class="alt-font fs-18 fw-700 d-block w-90 text-dark-gray border-bottom border-2 border-color-dark-gray pb-15px mb-15px xs-w-100"
        >
          <i class="feather icon-feather-phone icon-small me-10px"></i>
          {t.phone.title}
        </span>
        <a href={`tel:${t.phone.main}`}>
          {t.phone.main}
        </a>
        <br />
        <a href={`tel:${t.phone.alt}`}>
          {t.phone.alt}
        </a>
      </div>

      <!-- Map -->
      <div class="col text-center text-sm-start">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3121.44418891455!2d113.71641299999999!3d-8.165157599999999!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2dd694351d727e69%3A0xec33c34804a10832!2sUniversity%20of%20Jember!5e1!3m2!1sen!2sid!4v1767671308272!5m2!1sen!2sid"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </div>
</section>
