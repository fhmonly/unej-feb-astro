---
import ModulesGalleryCard from "@/components/modules/gallery/card.astro";
import ContentRenderer from "@/components/widgets/content/contentRenderer.astro";
import ContentFilterGrid from "@/components/widgets/contentFilter/contentFilterGrid.astro";
import ContentFilterGridItem from "@/components/widgets/contentFilter/contentFilterGridItem.astro";
import ContentFilterNavTabItem from "@/components/widgets/contentFilter/contentFilterNavTabItem.astro";
import ContentFilterNavTabs from "@/components/widgets/contentFilter/contentFilterNavTabs.astro";
import PageSection from "@/components/widgets/pageSection.astro";
import { getLocale } from "@/i18n/i18n";
import { galleryService } from "@/services/gallery.service";

const dict = {
  id: {
    contentNotAvailableYet: "Galeri belum tersedia saat ini",
  },
  en: {
    contentNotAvailableYet: "Gallery is not available yet",
  },
};

const locale = getLocale(Astro);
const t = dict[locale];

const gsGetPhotoGallery = await galleryService.getPhotoGallery();
const photoGallery = gsGetPhotoGallery?.data || [];

type ContentTabItem = {
  filter: "*" | `.${string}`;
  isActive: boolean;
  label: string;
};
function getAvailableJenis(data: typeof photoGallery): ContentTabItem[] {
  const jenis = [
    ...new Set(data.map((item) => item.jenis)),
  ].map<ContentTabItem>((jenis) => ({
    filter: `.${jenis}`,
    isActive: false,
    label: jenis,
  }));
  jenis.splice(0, 0, {
    filter: "*",
    isActive: true,
    label: "All",
  });

  return jenis;
}
---

<PageSection class="pt-0">
  <div class="row align-items-center justify-content-center" slot="header">
    <div
      class="col-12 col-xl-6 col-lg-8 text-center position-relative page-title-double-large"
    >
      <div
        class="d-flex flex-column justify-content-center extra-very-small-screen"
      >
        <h1 class="text-dark-gray alt-font ls-minus-1px fw-700 mb-20px">
          Gallery
        </h1>
        <h2 class="d-inline-block fw-400 ls-0px w-80 xs-w-100 mx-auto">
          Kumpulan dokumentasi kegiatan unggulan FEB
        </h2>
      </div>
    </div>
  </div>
  <div>
    <ContentRenderer
      showContent={!!photoGallery.length}
      fallbackText={t.contentNotAvailableYet}
    >
      <ContentFilterNavTabs>
        {
          getAvailableJenis(photoGallery).map((item, i) => (
            <ContentFilterNavTabItem
              isActive={item.isActive}
              filter={item.filter}
            >
              {item.label}
            </ContentFilterNavTabItem>
          ))
        }
      </ContentFilterNavTabs>
      <ContentFilterGrid>
        {
          photoGallery.map((item) => (
            <ContentFilterGridItem keywords={[item.jenis]}>
              <ModulesGalleryCard image={item.file} title={item.judul} />
            </ContentFilterGridItem>
          ))
        }
      </ContentFilterGrid>
    </ContentRenderer>
  </div>
</PageSection>
