---
import PillDivider from "@/components/widgets/pillDivider.astro";
import { wordsJson } from "@/i18n/words";
import { getLocale } from "@i18n/i18n";
import { navJson } from "@i18n/navigation";

interface ProgramItem {
  label: string;
  url: string;
}

interface Program {
  title: string;
  count: number;
  items: ProgramItem[];
}

const t = navJson[getLocale(Astro)].navigation;

const prodis: Program[] = [
  {
    title: t.main.academic_programs.diploma_programs.title,
    count: 4,
    items: [
      {
        label: t.main.academic_programs.diploma_programs.company_management,
        url: "/academic-programs/diploma/psd3mp",
      },
      {
        label:
          t.main.academic_programs.diploma_programs.financial_administration,
        url: "/academic-programs/diploma/psd3ak",
      },
      {
        label: t.main.academic_programs.diploma_programs.secretary,
        url: "/academic-programs/diploma/psd3set",
      },
      {
        label: t.main.academic_programs.diploma_programs.accounting,
        url: "/academic-programs/diploma/psd3akt",
      },
    ],
  },
  {
    title: t.main.academic_programs.bachelor_programs.title,
    count: 4,
    items: [
      {
        label: t.main.academic_programs.bachelor_programs.accounting,
        url: "/academic-programs/bachelor/accounting",
      },
      {
        label: t.main.academic_programs.bachelor_programs.management,
        url: "/academic-programs/bachelor/management",
      },
      {
        label: t.main.academic_programs.bachelor_programs.development_economics,
        url: "/academic-programs/bachelor/psep",
      },
      {
        label: t.main.academic_programs.bachelor_programs.sharia_economics,
        url: "/academic-programs/bachelor/pses",
      },
    ],
  },
  {
    title: t.main.academic_programs.master_programs.title,
    count: 3,
    items: [
      {
        label: t.main.academic_programs.master_programs.economics,
        url: "/academic-programs/master/psmie",
      },
      {
        label: t.main.academic_programs.master_programs.management,
        url: "/academic-programs/master/psmm",
      },
      {
        label: t.main.academic_programs.master_programs.accounting,
        url: "/academic-programs/master/psmak",
      },
    ],
  },
  {
    title: t.main.academic_programs.doctoral_programs.title,
    count: 3,
    items: [
      {
        label: t.main.academic_programs.doctoral_programs.economics,
        url: "/academic-programs/doctoral/pdie",
      },
      {
        label: t.main.academic_programs.doctoral_programs.management,
        url: "/academic-programs/doctoral/pdim",
      },
      {
        label: t.main.academic_programs.doctoral_programs.accounting,
        url: "/academic-programs/doctoral/accounting",
      },
    ],
  },
];

const tWord = wordsJson[getLocale(Astro)];
---

<section
  class="py-0 sm-pt-50px mb-3"
  style="margin-top: 90px"
  data-anime='{ "translateY": [0, 0], "opacity": [0,1], "duration": 1200, "delay": 0, "staggervalue": 150, "easing": "easeOutQuad" }'
>
  <div class="container">
    <PillDivider text={tWord.study_programs} />
    <div class="my-3 mb-5"></div>
    <div class="row g-4">
      {
        prodis.map((program) => (
          <div class="col-md-6">
            <div class="feature-box p-4 h-100 border radius-6 shadow-sm">
              <h4 class="fw-semibold mb-1">{program.title}</h4>
              <p class="small text-muted mb-3">
                {program.count} {tWord.study_programs}
              </p>

              <ul class="list-unstyled m-0">
                {program.items.map((item) => (
                  <li class="py-1">
                    <a href={item.url} class="text-decoration-underline">
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .feature-box {
    background: #fff;
    transition: 0.3s ease;
  }
  .feature-box:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }
  .radius-6 {
    border-radius: 6px;
  }
  .shadow-sm {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }
</style>
