---
import ModulesAboutLeaderCard from "@components/modules/about/leaderCard.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  locale?: "id" | "en";
}

const { locale = "id", class: className, ...attrs } = Astro.props;

const i18n = {
  en: {
    title: "Leaders",
    subtitle: "Leaders",
    leaders: [
      {
        name: "Prof. Dr. Isti Fadah, M.Si., CRA., CMA.",
        role: "Dean",
        img: "https://www2.feb.unej.ac.id/assets/uploads/foto_1728979456.png",
        alt: "Dean",
      },
      {
        name: "Prof. Dr. Novi Puspitasari, S.E., M.M",
        role: "Vice Dean for Academic Affairs",
        img: "https://www2.feb.unej.ac.id/assets/uploads/foto_1728634107.png",
        alt: "Vice Dean for Academic Affairs",
      },
      {
        name: "Dr. Nining Ika Wahyuni, S.E. M.Sc, Ak.",
        role: "Vice Dean for General Affairs and Finance",
        img: "https://www2.feb.unej.ac.id/assets/uploads/foto_1736228689.jpeg",
        alt: "Vice Dean for General Affairs and Finance",
      },
      {
        name: "Dr. Teguh Hadi Priyono, S.E., M.Si.",
        role: "Vice Dean for Student Affairs and Alumni",
        img: "https://www2.feb.unej.ac.id/assets/uploads/foto_1728628968.png",
        alt: "Vice Dean for Student Affairs and Alumni",
      },
      {
        name: "Sugianto, S.E., M.M.",
        role: "Vice Coordinator for Academic, Student and Alumni Affairs",
        img: "https://www2.feb.unej.ac.id/assets/uploads/foto_1728544738.png",
        alt: "Vice Coordinator for Academic, Student and Alumni Affairs",
      },
      {
        name: "Nurina Fitrianingtyas, SKM.",
        role: "Vice Coordinator of Finance and Personnel",
        img: "https://www2.feb.unej.ac.id/assets/uploads/foto_1728544761.png",
        alt: "Vice Coordinator of Finance and Personnel",
      },
    ],
  },
  id: {
    title: "Pimpinan",
    subtitle: "Pimpinan",
    leaders: [
      {
        name: "Prof. Dr. Isti Fadah, M.Si., CRA., CMA.",
        role: "Dekan",
        img: "https://www2.feb.unej.ac.id/assets/uploads/foto_1728979456.png",
        alt: "Dekan",
      },
      {
        name: "Prof. Dr. Novi Puspitasari, S.E., M.M",
        role: "Wakil Dekan Bidang Akademik",
        img: "https://www2.feb.unej.ac.id/assets/uploads/foto_1728634107.png",
        alt: "Wakil Dekan Bidang Akademik",
      },
      {
        name: "Dr. Nining Ika Wahyuni, S.E. M.Sc, Ak.",
        role: "Wakil Dekan Bidang Umum dan Keuangan",
        img: "https://www2.feb.unej.ac.id/assets/uploads/foto_1736228689.jpeg",
        alt: "Wakil Dekan Bidang Umum dan Keuangan",
      },
      {
        name: "Dr. Teguh Hadi Priyono, S.E., M.Si.",
        role: "Wakil Dekan Bidang Kemahasiswaan dan Alumni",
        img: "https://www2.feb.unej.ac.id/assets/uploads/foto_1728628968.png",
        alt: "Wakil Dekan Bidang Kemahasiswaan dan Alumni",
      },
      {
        name: "Sugianto, S.E., M.M.",
        role: "Koordinator Akademik, Kemahasiswaan dan Alumni",
        img: "https://www2.feb.unej.ac.id/assets/uploads/foto_1728544738.png",
        alt: "Koordinator Akademik, Kemahasiswaan dan Alumni",
      },
      {
        name: "Nurina Fitrianingtyas, SKM.",
        role: "Koordinator Keuangan dan Kepegawaian",
        img: "https://www2.feb.unej.ac.id/assets/uploads/foto_1728544761.png",
        alt: "Koordinator Keuangan dan Kepegawaian",
      },
    ],
  },
};

const t = i18n[locale];
---

<section id="team" class:list={[className, "team-section"]} {...attrs}>
  <div class="container">
    <div class="section-title" data-aos="fade-up">
      <h3 class="text-dark-gray fs-700">{t.title}</h3>
      <p class="team-subtitle">{t.subtitle}</p>
    </div>

    <div
      class="row row-cols-2 row-cols-md-3 justify-content-center"
      data-aos="fade-left"
    >
      {
        t.leaders.map((leader, i) => (
          <div data-aos-delay={(i + 1) * 100}>
            <ModulesAboutLeaderCard
              department={leader.role}
              fullName={leader.name}
              image={leader.img}
              alt={leader.alt}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
