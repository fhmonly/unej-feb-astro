---
import { layoutsJson } from "@/i18n/layouts";
import { getLocale, useI18n } from "@i18n/i18n";

const locale = getLocale(Astro);
const icon = [
  {
    rel: "apple-touch-icon",
    sizes: "48x48",
    href: "/_astro/icons/icon-48x48.png",
  },
  {
    rel: "apple-touch-icon",
    sizes: "72x72",
    href: "/_astro/icons/icon-72x72.png",
  },
  {
    rel: "apple-touch-icon",
    sizes: "96x96",
    href: "/_astro/icons/icon-96x96.png",
  },
  {
    rel: "apple-touch-icon",
    sizes: "128x128",
    href: "/_astro/icons/icon-128x128.png",
  },
  {
    rel: "apple-touch-icon",
    sizes: "144x144",
    href: "/_astro/icons/icon-144x144.png",
  },
  {
    rel: "apple-touch-icon",
    sizes: "152x152",
    href: "/_astro/icons/icon-152x152.png",
  },
  {
    rel: "apple-touch-icon",
    sizes: "192x192",
    href: "/_astro/icons/icon-192x192.png",
  },

  // ===== Standard Icons (Browser) =====
  {
    rel: "icon",
    type: "image/png",
    sizes: "48x48",
    href: "/_astro/icons/icon-48x48.png",
  },
  {
    rel: "icon",
    type: "image/png",
    sizes: "72x72",
    href: "/_astro/icons/icon-72x72.png",
  },
  {
    rel: "icon",
    type: "image/png",
    sizes: "96x96",
    href: "/_astro/icons/icon-96x96.png",
  },
  {
    rel: "icon",
    type: "image/png",
    sizes: "128x128",
    href: "/_astro/icons/icon-128x128.png",
  },
  {
    rel: "icon",
    type: "image/png",
    sizes: "144x144",
    href: "/_astro/icons/icon-144x144.png",
  },
  {
    rel: "icon",
    type: "image/png",
    sizes: "152x152",
    href: "/_astro/icons/icon-152x152.png",
  },
  {
    rel: "icon",
    type: "image/png",
    sizes: "192x192",
    href: "/_astro/icons/icon-192x192.png",
  },
  {
    rel: "icon",
    type: "image/png",
    sizes: "256x256",
    href: "/_astro/icons/icon-256x256.png",
  },
  {
    rel: "icon",
    type: "image/png",
    sizes: "384x384",
    href: "/_astro/icons/icon-384x384.png",
  },
  {
    rel: "icon",
    type: "image/png",
    sizes: "512x512",
    href: "/_astro/icons/icon-512x512.png",
  },
];

const tLayout = useI18n(layoutsJson, getLocale(Astro));
---

<html class="no-js bg-dark-gray pending" lang={locale}>
  <head>
    <slot name="title" />

    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="author" content="Fhmonly" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <meta name="description" content={tLayout.html.desc} />

    <slot name="meta" />

    <!-- favicon icon -->
    <link rel="shortcut icon" href="/_astro/favicon.ico" />
    {
      icon.map((link) => (
        <link
          rel={link.rel}
          type={link.type}
          sizes={link.sizes}
          href={link.href}
        />
      ))
    }

    <!-- google fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- style sheets and font icons  -->
    <link rel="stylesheet" href="/_astro/v3/css/icon.css" />

    <style>
      html #loading-anim-adauhwdawdb {
        display: none;
      }
      html.pending {
        overflow: hidden;
      }
      html.pending #loading-anim-adauhwdawdb {
        position: fixed;
        bottom: 0;
        top: 0;
        left: 0;
        right: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: #f8f9fa;
        z-index: 99999;
      }
      .loader {
        width: 200px;
        height: 140px;
        scale: 0.5;
        background: #e4ff30;
        box-sizing: border-box;
        position: relative;
        border-radius: 8px;
        perspective: 1000px;
      }

      .loader:before {
        content: "";
        position: absolute;
        left: 10px;
        right: 10px;
        top: 10px;
        bottom: 10px;
        border-radius: 8px;
        background: #f5f5f5 no-repeat;
        background-size: 60px 10px;
        background-image:
          linear-gradient(#ddd 100px, transparent 0),
          linear-gradient(#ddd 100px, transparent 0),
          linear-gradient(#ddd 100px, transparent 0),
          linear-gradient(#ddd 100px, transparent 0),
          linear-gradient(#ddd 100px, transparent 0),
          linear-gradient(#ddd 100px, transparent 0);

        background-position:
          15px 30px,
          15px 60px,
          15px 90px,
          105px 30px,
          105px 60px,
          105px 90px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.25);
      }
      .loader:after {
        content: "";
        position: absolute;
        width: calc(50% - 10px);
        right: 10px;
        top: 10px;
        bottom: 10px;
        border-radius: 8px;
        background: #fff no-repeat;
        background-size: 60px 10px;
        background-image:
          linear-gradient(#ddd 100px, transparent 0),
          linear-gradient(#ddd 100px, transparent 0),
          linear-gradient(#ddd 100px, transparent 0);
        background-position:
          50% 30px,
          50% 60px,
          50% 90px;
        transform: rotateY(0deg);
        transform-origin: left center;
        animation: paging 1s linear infinite;
      }

      @keyframes paging {
        to {
          transform: rotateY(-180deg);
        }
      }
    </style>

    <slot name="head">
      <!-- slider revolution CSS files -->

      <!-- style sheets and font icons  -->
    </slot>
  </head>

  <body
    data-mobile-nav-trigger-alignment="right"
    data-mobile-nav-style="modern"
    data-mobile-nav-bg-color="#1d1d1d"
  >
    <div id="loading-anim-adauhwdawdb">
      <div>
        <div class="loader"></div>
      </div>
    </div>

    <slot name="content" />

    <slot name="scroll-progress">
      <div class="scroll-progress d-none d-xxl-block">
        <a href="#" class="scroll-top" aria-label="scroll">
          <span class="scroll-text">Scroll</span><span class="scroll-line"
            ><span class="scroll-point"></span></span
          >
        </a>
      </div>
    </slot>

    <slot name="script" />
  </body>
</html>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelector("html")?.classList.remove("pending");
  });
</script>
