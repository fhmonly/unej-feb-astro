---
// FooterColumn.astro
const { title, items } = Astro.props;
---

<div class="mb-4 text-center">
  <h5 class="fw-semibold mb-3" style="color:#ffffff;">{title}</h5>
  <ul class="list-unstyled">
    {
      items.map((item: any) => (
        <li class="mb-2">
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-decoration-none hover-link"
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</div>
