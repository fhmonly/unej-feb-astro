---

<nav
  class="navbar navbar-expand-lg mini-header header-light bg-light header-reverse header-demo glass-effect gjkhjkituq2bmn"
  data-header-hover="light"
>
  <div class="container-lg">
    <!-- logo -->
    <div class="col-auto me-auto ps-lg-0">
      <a class="navbar-brand" href="/" style="padding: 12px 0;">
        <img
          src="/_astro/images/unej-removebg.png"
          style="max-height: 40px;"
          class="default-logo"
        />
        <img
          src="/_astro/images/unej-removebg.png"
          style="max-height: 40px;"
          class="alt-logo"
        />
        <img
          src="/_astro/images/unej-removebg.png"
          style="max-height: 40px;"
          class="mobile-logo"
        />
      </a>
    </div>

    <!-- menu -->
    <div class="col-auto menu-order position-static">
      <button
        id="awhdjkashdjkashd"
        class="navbar-toggler ahwuidhasdu-real"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarNav"
      >
        <span class="navbar-toggler-line"></span>
        <span class="navbar-toggler-line"></span>
        <span class="navbar-toggler-line"></span>
        <span class="navbar-toggler-line"></span>
      </button>
      <button
        id="awhdjkashdjkashd"
        class="navbar-toggler ahwuidhasdu"
        type="button"
      >
        <span class="navbar-toggler-line"></span>
        <span class="navbar-toggler-line"></span>
        <span class="navbar-toggler-line"></span>
        <span class="navbar-toggler-line"></span>
      </button>

      <div
        class="collapse navbar-collapse justify-content-center"
        id="navbarNav"
      >
        <ul class="navbar-nav">
          {menuConfig.map((menu) => <LayoutHeaderNavNestedMenu item={menu} />)}
        </ul>
      </div>
    </div>

    <!-- language -->
    <div class="col-auto pe-lg-0 ps-lg-0">
      <div class="header-icon">
        <div class="header-language-icon icon">
          <div class="dropdown header-language">
            <div
              class="dropdown-toggle"
              data-bs-toggle="dropdown"
              aria-expanded="false"
              style="padding-left: 10px;"
            >
              <i class="feather icon-feather-globe"></i>
            </div>
            <ul class="dropdown-menu language-dropdown">
              {
                languages.map((lang) => (
                  <li>
                    <a
                      href={
                        lang.code === locale
                          ? "javascript:void(0);"
                          : switchLocalePath(fullPath, lang.code as any)
                      }
                      title={lang.name}
                      class="text-truncate"
                    >
                      <span class="icon-country">
                        <img
                          src={`/_astro/images/country-flag-16X16/${lang.name}.png`}
                          alt=""
                        />
                      </span>
                      {lang.name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</nav>
<style>
  body.navbar-collapse-show .ahwuidhasdu-real {
    display: none !important;
  }
  body .ahwuidhasdu {
    display: none !important;
  }

  body.navbar-collapse-show .ahwuidhasdu {
    display: inline-block !important;
  }
</style>
