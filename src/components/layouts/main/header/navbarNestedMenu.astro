---
import LayoutHeaderNavNestedMenu from "@components/layouts/main/header/navbarNestedMenu.astro";
import { getLocale, getLocaleLink } from "@i18n/i18n";

export type MenuItem = {
  label: string;
  to?: string;
  icon?: {
    fa?: string;
    bi?: string;
  };
  target?: string;
  children?: MenuItem[];
};

type Props = {
  item: MenuItem;
  level?: number;
};

const {
  item,
  level = 0,
} = Astro.props as Props;

const dropdownClass = level === 0 ? "simple-dropdown" : "dropdown";
---

<li class={`nav-item ${item.children ? `dropdown ${dropdownClass}` : ""}`}>
  {item.children ? (
    <>
      <!-- Parent dropdown -->
      <a href="javascript:void(0);" class="nav-link text-truncate d-flex align-items-center justify-content-between">
        <span class="d-flex align-items-center">
          {level > 0 && item.icon?.fa && (
            <i
              class={item.icon.fa}
              style={`position:static;width:16px;margin-right:10px;display:inline-flex;justify-content:center;align-items:center;padding-top: 5px;${level > 0 ? "color:white;" : ""}`}
            />
          )}

          {level > 0 && item.icon?.bi && (
            <i
              class={`bi ${item.icon.bi}`}
              style={`position:static;width:16px;margin-right:10px;display:inline-flex;justify-content:center;align-items:center;padding-top: 5px;${level > 0 ? "color:white;" : ""}`}
            />
          )}

          <span style={level > 0 ? "color:white;" : ""}>
            {item.label}
          </span>
        </span>

        <!-- Arrow Down -->
        {
          level === 0 ?
          (<i class="bi bi-chevron-down d-inline-block d-lg-none" style="margin-left:5px;" ></i>):
          (<></>)
        }
      </a>

      <ul class="dropdown-menu">
        {item.children.map((child) => (
          <LayoutHeaderNavNestedMenu item={child} level={level + 1} />
        ))}
      </ul>
    </>
  ) : (
    <a
      href={item.to ? getLocaleLink(getLocale(Astro), item.to) : "#"}
      target={item.target}
      class="nav-link d-flex align-items-start"
      style="display:flex;"
    >
      {item.icon?.fa && (
        <i
          class={item.icon.fa}
          style={`position:static;width:16px;margin-right:10px;display:inline-flex;justify-content:center;align-items:center;padding-top: 5px;${level > 0 ? "color:white;" : ""}`}
        />
      )}

      {item.icon?.bi && (
        <i
          class={`bi ${item.icon.bi}`}
          style={`position:static;width:16px;margin-right:10px;display:inline-flex;justify-content:center;align-items:center;padding-top: 5px;${level > 0 ? "color:white;" : ""}`}
        />
      )}

      <span style="color:white;">
        {item.label}
      </span>
    </a>
  )}
</li>
<style>
@media (max-width: 991px) {
    .nav-item ul.dropdown-menu .nav-item ul.dropdown-menu {
    padding-left: 10px !important;
    } 
}
</style>
