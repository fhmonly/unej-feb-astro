---
import LayoutBase from "@components/layouts/base.astro";
import Footer from "@components/layouts/main/footer/footer.astro";
import Header from "@components/layouts/main/header/header.astro";

type Props = {
  title: string | null;
};

const { title } = Astro.props as Props;
---

<LayoutBase>
  <title slot="title">{!!title ? `${title} | FEB UNEJ` : "FEB UNEJ"}</title>

  <Fragment slot="head">
    <!-- slider revolution CSS files -->
    <link
      rel="stylesheet"
      type="text/css"
      href="/_astro/revolution/css/settings.css"
    />
    <link
      rel="stylesheet"
      type="text/css"
      href="/_astro/revolution/css/layers.css"
    />
    <link
      rel="stylesheet"
      type="text/css"
      href="/_astro/revolution/css/navigation.css"
    />

    <!-- style sheets and font icons  -->
    <link rel="stylesheet" href="/_astro/css/icon.min.css" />
    <link rel="stylesheet" href="/_astro/v3/css/vendors.min.css" />
    <link rel="stylesheet" href="/_astro/v3/css/style.min.css" />
    <link rel="stylesheet" href="/_astro/v3/css/responsive.min.css" />
    <link rel="stylesheet" href="/_astro/demos/corporate/corporate.css" />
    <link rel="stylesheet" href="/_astro/custom/style.css" />

    <slot name="head" />
  </Fragment>

  <div slot="content">
    <Header />
    <slot />
    <Footer />
  </div>

  <Fragment slot="script">
    <slot name="script-jquery">
      <script is:inline src="/_astro/js/jquery.js"></script>
    </slot>
    <slot name="script-vendor">
      <script is:inline src="/_astro/js/vendors.min.js"></script>
      <script is:inline src="/_astro/js/vendors/bootstrap.bundle.js"></script>
    </slot>
    <slot name="script-plugin">
      <script
        is:inline
        src="/_astro/revolution/js/jquery.themepunch.revolution.min.js"
      ></script>
    </slot>
    <script is:inline src="/_astro/revolution/js/jquery.themepunch.tools.min.js"
    ></script>
    <slot name="script-main">
      <script is:inline src="/_astro/js/main.js"></script>
    </slot>

    <slot name="bodyClose" />
  </Fragment>
</LayoutBase>
